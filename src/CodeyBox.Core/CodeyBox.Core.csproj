<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Configuration.Abstractions" Version="10.0.7" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.7" />
    <PackageReference Include="Serilog" Version="4.2.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- The NuGet-home recovery script is the single source for the shell
         preamble NuGetHomeSelfHeal composes: its marked shared-helpers region
         is lifted verbatim out of this resource at load time, so a guard
         change in the script cannot land in only one copy. -->
    <EmbeddedResource Include="../../scripts/nuget-home-heal.sh"
                      LogicalName="CodeyBox.Core.nuget-home-heal.sh" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="CodeyBox.Tests" />
    <!-- The orchestrator's required-build gate composes the embedded heal
         preamble's fragments (NuGetHomeSelfHeal.SharedHelpers /
         DecisionFragment) explicitly rather than consuming the composed
         Preamble. -->
    <InternalsVisibleTo Include="CodeyBox.Orchestrator" />
  </ItemGroup>

</Project>
