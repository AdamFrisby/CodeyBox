<Project Sdk="Microsoft.NET.Sdk.Web">

  <ItemGroup>
    <ProjectReference Include="..\CodeyBox.Core\CodeyBox.Core.csproj" />
    <ProjectReference Include="..\CodeyBox.Orchestrator\CodeyBox.Orchestrator.csproj" />
    <ProjectReference Include="..\CodeyBox.Sandbox.Process\CodeyBox.Sandbox.Process.csproj" />
    <ProjectReference Include="..\CodeyBox.Agents.Claude\CodeyBox.Agents.Claude.csproj" />
    <ProjectReference Include="..\CodeyBox.Agents.Copilot\CodeyBox.Agents.Copilot.csproj" />
    <ProjectReference Include="..\CodeyBox.Agents.Codex\CodeyBox.Agents.Codex.csproj" />
    <ProjectReference Include="..\CodeyBox.Agents.Gemini\CodeyBox.Agents.Gemini.csproj" />
    <ProjectReference Include="..\CodeyBox.Agents.Cursor\CodeyBox.Agents.Cursor.csproj" />
    <ProjectReference Include="..\CodeyBox.Agents.Opencode\CodeyBox.Agents.Opencode.csproj" />
    <ProjectReference Include="..\CodeyBox.Agents.Antigravity\CodeyBox.Agents.Antigravity.csproj" />
    <ProjectReference Include="..\CodeyBox.Upstream.GitHub\CodeyBox.Upstream.GitHub.csproj" />
    <ProjectReference Include="..\CodeyBox.Git\CodeyBox.Git.csproj" />
    <ProjectReference Include="..\CodeyBox.Projects\CodeyBox.Projects.csproj" />
    <ProjectReference Include="..\CodeyBox.Audit.Presets\CodeyBox.Audit.Presets.csproj" />
    <ProjectReference Include="..\CodeyBox.Audit.Llm\CodeyBox.Audit.Llm.csproj" />
    <ProjectReference Include="..\CodeyBox.Audit.Shell\CodeyBox.Audit.Shell.csproj" />
    <ProjectReference Include="..\CodeyBox.Sandbox.Bubblewrap\CodeyBox.Sandbox.Bubblewrap.csproj" />
    <ProjectReference Include="..\CodeyBox.Sandbox.Multipass\CodeyBox.Sandbox.Multipass.csproj" />
    <ProjectReference Include="..\CodeyBox.Webhooks\CodeyBox.Webhooks.csproj" />
    <ProjectReference Include="..\CodeyBox.Notifications\CodeyBox.Notifications.csproj" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <!--
    Acknowledge known moderate-severity vulnerabilities in the OTel packages that are the only
    versions available in this environment. No patched versions are present in the local NuGet
    cache. These are transitive/direct OTel SDK dependencies; they do not affect data integrity
    or authentication and have no known exploit path in this server-side context.
    Suppress the audit errors so the build remains clean (TreatWarningsAsErrors=true globally).
    Remove these entries once patched versions are available and the package references are updated.
  -->
  <ItemGroup>
    <NuGetAuditSuppress Include="https://github.com/advisories/GHSA-g94r-2vxg-569j" />
    <NuGetAuditSuppress Include="https://github.com/advisories/GHSA-4625-4j76-fww9" />
    <!-- GHSA-9j88-vvj5-vhgr / GHSA-g7hc-96xr-gvvx: BouncyCastle transitive via MailKit/MimeKit (Notifications project ref).
         See CodeyBox.Notifications.csproj for rationale. -->
    <NuGetAuditSuppress Include="https://github.com/advisories/GHSA-9j88-vvj5-vhgr" />
    <NuGetAuditSuppress Include="https://github.com/advisories/GHSA-g7hc-96xr-gvvx" />
  </ItemGroup>

  <!--
    Bundled per-(agent, model) pricing defaults. Copied next to the binary so
    AgentPricingDefaults can resolve it via IHostEnvironment.ContentRootPath
    in both `dotnet run` and published deployments. See docs/agent-pricing.md.
    Uses Update (not Include) because the .NET Web SDK auto-discovers
    Content items at the project root.
  -->
  <ItemGroup>
    <Content Update="agent-pricing-defaults.json" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <!--
    Bundled default task-templates (check-and-act definitions). Copied into a
    `templates` directory next to the binary so FileTaskTemplateRegistry can
    resolve them via IHostEnvironment.ContentRootPath in both `dotnet run` and
    published deployments. Uses Update (not Include) because the .NET Web SDK
    auto-discovers Content items under the project root; this only sets the copy
    behaviour so the JSON ships next to the binary.
  -->
  <ItemGroup>
    <Content Update="templates\**\*.json" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Serilog.AspNetCore" Version="8.0.3" />
    <PackageReference Include="Serilog.Extensions.Hosting" Version="8.0.0" />
    <PackageReference Include="Serilog.Sinks.File" Version="6.0.0" />
    <PackageReference Include="Serilog.Sinks.Console" Version="6.0.0" />
    <PackageReference Include="Serilog.Formatting.Compact" Version="3.0.0" />
    <PackageReference Include="Serilog.Enrichers.Environment" Version="3.0.0" />
    <PackageReference Include="Serilog.Enrichers.Thread" Version="4.0.0" />
    <PackageReference Include="OpenTelemetry.Extensions.Hosting" Version="1.11.2" />
    <PackageReference Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" Version="1.11.2" />
    <!-- The Prometheus exporter remains a beta-tagged package upstream (no stable
         release exists). It is the only sanctioned in-process Prometheus scrape
         exporter for OTel .NET. Pinned alongside the other OTel packages so
         operators can upgrade them together. -->
    <PackageReference Include="OpenTelemetry.Exporter.Prometheus.AspNetCore" Version="1.16.0-beta.1" />
    <PackageReference Include="OpenTelemetry.Instrumentation.AspNetCore" Version="1.12.0" />
    <PackageReference Include="OpenTelemetry.Instrumentation.Http" Version="1.12.0" />
    <PackageReference Include="OpenTelemetry.Instrumentation.Runtime" Version="1.12.0" />
  </ItemGroup>

</Project>
