    <ProjectReference Include="..\CodeyBox.Agents.Copilot\CodeyBox.Agents.Copilot.csproj" />
    <ProjectReference Include="..\CodeyBox.Agents.Codex\CodeyBox.Agents.Codex.csproj" />
    <ProjectReference Include="..\CodeyBox.Agents.Gemini\CodeyBox.Agents.Gemini.csproj" />
    <ProjectReference Include="..\CodeyBox.Agents.Cursor\CodeyBox.Agents.Cursor.csproj" />
    <ProjectReference Include="..\CodeyBox.Agents.Opencode\CodeyBox.Agents.Opencode.csproj" />
    <ProjectReference Include="..\CodeyBox.Agents.Antigravity\CodeyBox.Agents.Antigravity.csproj" />
    <ProjectReference Include="..\CodeyBox.Agents.Crock\CodeyBox.Agents.Crock.csproj" />
    <ProjectReference Include="..\CodeyBox.Upstream.GitHub\CodeyBox.Upstream.GitHub.csproj" />
    <ProjectReference Include="..\CodeyBox.Git\CodeyBox.Git.csproj" />
    <ProjectReference Include="..\CodeyBox.Projects\CodeyBox.Projects.csproj" />
    <ProjectReference Include="..\CodeyBox.Audit.Presets\CodeyBox.Audit.Presets.csproj" />
    <ProjectReference Include="..\CodeyBox.Audit.Llm\CodeyBox.Audit.Llm.csproj" />
    <ProjectReference Include="..\CodeyBox.Audit.Shell\CodeyBox.Audit.Shell.csproj" />
    <ProjectReference Include="..\CodeyBox.Sandbox.Bubblewrap\CodeyBox.Sandbox.Bubblewrap.csproj" />
    <ProjectReference Include="..\CodeyBox.Sandbox.Incus\CodeyBox.Sandbox.Incus.csproj" />
    <ProjectReference Include="..\CodeyBox.Sandbox.Multipass\CodeyBox.Sandbox.Multipass.csproj" />
    <ProjectReference Include="..\CodeyBox.Sandbox.MultipassRemote\CodeyBox.Sandbox.MultipassRemote.csproj" />
    <ProjectReference Include="..\CodeyBox.Sandbox.Sprites\CodeyBox.Sandbox.Sprites.csproj" />
    <ProjectReference Include="..\CodeyBox.Webhooks\CodeyBox.Webhooks.csproj" />
