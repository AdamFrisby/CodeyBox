{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  },
  "AllowedHosts": "*",
  "CodeyBox": {
    "GitRootDirectory": "/var/lib/codeybox/repos",
    "StateDatabasePath": "/var/lib/codeybox/state.db",
    "SqliteWriteGate": {
      "AcquisitionTimeout": "00:00:05",
      "MaxHoldDuration": "00:00:05"
    },
    "SandboxImageReference": "",
    "AgentAllowedHosts": [
      "api.anthropic.com",
      "api.openai.com",
      "api.githubcopilot.com",
      "generativelanguage.googleapis.com"
    ],
    "AuditToolAllowedHosts": [
      "api.nuget.org",
      "www.nuget.org",
      "pypi.org",
      "files.pythonhosted.org",
      "registry.npmjs.org",
      "vuln.go.dev",
      "proxy.golang.org",
      "sum.golang.org",
      "crates.io",
      "index.crates.io",
      "static.crates.io",
      "github.com",
      "release-assets.githubusercontent.com",
      "semgrep.dev",
      "registry.semgrep.dev",
      "api.semgrep.dev"
    ],
    "MultipassExtraRuncmd": [
      "apt-get update",
      "apt-get install -y curl ca-certificates tar python3 python3-pip",
      "set -eux\nDOTNET_SDK_VERSION=10.0.301\nDOTNET_INSTALL_SCRIPT=/tmp/dotnet-install.sh\ncurl -fsSL https://dot.net/v1/dotnet-install.sh -o \"$DOTNET_INSTALL_SCRIPT\"\nbash \"$DOTNET_INSTALL_SCRIPT\" --version \"$DOTNET_SDK_VERSION\" --install-dir /usr/share/dotnet\nln -sf /usr/share/dotnet/dotnet /usr/local/bin/dotnet\nrm \"$DOTNET_INSTALL_SCRIPT\"\ndotnet --version | grep -Fx \"$DOTNET_SDK_VERSION\"",
      "set -eux\nGITLEAKS_VERSION=8.29.0\ncase \"$(uname -m)\" in\n  x86_64|amd64) GITLEAKS_ARCH=x64; GITLEAKS_SHA256=39e07ad810336fd0ae80d0bd61c60d0521f628173e7583583b5df4a38738522c ;;\n  aarch64|arm64) GITLEAKS_ARCH=arm64; GITLEAKS_SHA256=4c811a7c23296c7163ebab166ec67cd8a31eb9922caf06a7cac4d6dd872e4159 ;;\n  *) echo \"unsupported gitleaks architecture: $(uname -m)\" >&2; exit 1 ;;\nesac\nGITLEAKS_TGZ=/tmp/gitleaks_${GITLEAKS_VERSION}_linux_${GITLEAKS_ARCH}.tar.gz\ncurl -fsSL -o \"$GITLEAKS_TGZ\" \"https://github.com/gitleaks/gitleaks/releases/download/v${GITLEAKS_VERSION}/gitleaks_${GITLEAKS_VERSION}_linux_${GITLEAKS_ARCH}.tar.gz\"\nprintf '%s  %s\\n' \"$GITLEAKS_SHA256\" \"$GITLEAKS_TGZ\" | sha256sum -c -\ntar -xzf \"$GITLEAKS_TGZ\" -C /usr/local/bin gitleaks\nchmod 0755 /usr/local/bin/gitleaks\nrm \"$GITLEAKS_TGZ\"",
      "python3 -m pip install --break-system-packages --no-cache-dir semgrep==1.168.0",
      "gitleaks version | grep -Fx 8.29.0",
      "semgrep --version | grep -Fx 1.168.0"
    ],
    "SandboxNetworkProfiles": {
      "graphical": "cb-graphical"
    },
    "Concurrency": 2,
    "Otel": {
      "Enabled": false,
      "OtlpEndpoint": null,
      "ExportProtocol": "grpc",
      "ServiceName": "codeybox"
    },
    "UpstreamPushMaxAttempts": 5,
    "UpstreamPushBackoffSeconds": 15,
    "PhaseAbsoluteTimeoutMultiplier": 3.0,
    "PipelineTuning": {
      "DefaultQuotaFailurePause": "00:05:00",
      "QuotaExhaustionFallbackTtl": "01:00:00",
      "MaxParsedQuotaResetWindow": "1.00:00:00",
      "MergeSandboxStagingRestoreAttempts": 2,
      "MaxQuestionsPerWorkItem": 10,
      "AgentSuspendMaxRetries": 1,
      "AgentSessionResumeMaxAttempts": 2,
      "MaxRetainedAgentTurnSandboxes": 16,
      "AuditShortCircuitEnabled": true,
      "AuditorIdleTimeout": "00:05:00",
      "BlockRedundantDotnetBuildTestInAuditSandbox": true
    },
    "PromptPreprocessing": {
      "ProjectRulesPath": "AGENTS.md"
    },
    "BudgetDeferralRecheck": {
      "PausedProjectRecheck": "00:01:00",
      "HourlyLimitRecheck": "00:05:00",
      "DailyLimitRecheck": "01:00:00",
      "ConcurrentLimitRecheck": "00:01:00"
    },
    "AgentDefaults": {
      "claude": "claude-opus-4-7",
      "codex": "gpt-5.5",
      "cursor": "composer-2.5",
      "opencode": "deepseek-v4-flash"
    },
    "AgentNetworkTolerance": {
      "codex": {
        "RequestMaxRetries": 8,
        "StreamMaxRetries": 15
      }
    },
    "WorkerProgressWatchdog": {
      "PerAgent": {
        "crock": {
          "ProgressTimeout": "06:00:00",
          "ItemStaleTimeout": "08:00:00"
        }
      }
    },
    "AgentPauses": {},
    "Defaults": {
      "Agent": "claude",
      "BaseBranch": "main",
      "Audit": {
        "MaxIterations": 3,
        "FailingSeverity": "Error",
        "AuditTypes": [
          "security",
          "architecture",
          "quality",
          "completeness",
          "cheating",
          "tests"
        ]
      }
    },
    "Projects": [],
    "AgentClasses": [
      {
        "Id": "frontier-coding",
        "DisplayName": "Frontier coding agents",
        "Members": [
          { "Agent": "claude", "Billing": "Subscription", "ModelId": "claude-opus-4-7", "QualityScore": 100, "Capabilities": [ "sensitive" ] },
          { "Agent": "codex", "Billing": "Subscription", "ModelId": "gpt-5.5", "QualityScore": 100, "Capabilities": [ "sensitive" ] },
          { "Agent": "cursor", "Billing": "Subscription", "ModelId": "composer-2.5", "QualityScore": 98 },
          { "Agent": "gemini", "Billing": "Subscription", "ModelId": "gemini-3-flash-preview", "QualityScore": 95, "ReasoningMode": "high" }
        ]
      }
    ],
    "AgentScoreModifiers": {
      "ByTimeOfDay": [
        {
          "Agent": "claude",
          "Modifier": -1,
          "Comment": "Anthropic peak hours (Mon-Fri 14:00-22:00 UTC): slight demotion so we lean on codex when tied. Adjust or remove to suit your billing agreement.",
          "Windows": [
            { "Days": [ "Mon", "Tue", "Wed", "Thu", "Fri" ], "StartUtc": "14:00", "EndUtc": "22:00" }
          ]
        }
      ]
    }
  }
}
