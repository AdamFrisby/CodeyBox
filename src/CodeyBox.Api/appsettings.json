{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  },
  "AllowedHosts": "*",
  "CodeyBox": {
    "GitRootDirectory": "/var/lib/codeybox/repos",
    "StateDatabasePath": "/var/lib/codeybox/state.db",
    "SandboxImageReference": "",
    "AgentAllowedHosts": [
      "api.anthropic.com",
      "api.openai.com",
      "api.githubcopilot.com",
      "generativelanguage.googleapis.com"
    ],
    "AuditToolAllowedHosts": [
      "api.nuget.org",
      "www.nuget.org",
      "pypi.org",
      "files.pythonhosted.org",
      "registry.npmjs.org",
      "vuln.go.dev",
      "proxy.golang.org",
      "sum.golang.org",
      "crates.io",
      "index.crates.io",
      "static.crates.io",
      "github.com"
    ],
    "SandboxNetworkProfiles": {
      "graphical": "cb-graphical"
    },
    "Concurrency": 2,
    "Otel": {
      "Enabled": false,
      "OtlpEndpoint": null,
      "ExportProtocol": "grpc",
      "ServiceName": "codeybox"
    },
    "UpstreamPushMaxAttempts": 5,
    "UpstreamPushBackoffSeconds": 15,
    "PhaseAbsoluteTimeoutMultiplier": 3.0,
    "PipelineTuning": {
      "DefaultQuotaFailurePause": "00:05:00",
      "QuotaExhaustionFallbackTtl": "01:00:00",
      "MaxParsedQuotaResetWindow": "1.00:00:00",
      "MergeSandboxStagingRestoreAttempts": 2,
      "MaxQuestionsPerWorkItem": 10,
      "AgentSuspendMaxRetries": 1,
      "AgentSessionResumeMaxAttempts": 2
    },
    "PromptPreprocessing": {
      "ProjectRulesPath": "AGENTS.md"
    },
    "BudgetDeferralRecheck": {
      "PausedProjectRecheck": "00:01:00",
      "HourlyLimitRecheck": "00:05:00",
      "DailyLimitRecheck": "01:00:00",
      "ConcurrentLimitRecheck": "00:01:00"
    },
    "AgentDefaults": {
      "claude": "claude-opus-4-7",
      "codex": "gpt-5.5",
      "cursor": "composer-2.5",
      "opencode": "opencode-go/deepseek-v4-flash"
    },
    "AgentPauses": {},
    "Defaults": {
      "Agent": "claude",
      "BaseBranch": "main",
      "Audit": {
        "MaxIterations": 3,
        "FailingSeverity": "Error",
        "AuditTypes": [
          "security",
          "architecture",
          "quality",
          "completeness",
          "cheating",
          "tests"
        ]
      }
    },
    "Projects": [],
    "AgentClasses": [
      {
        "Id": "frontier-coding",
        "DisplayName": "Frontier coding agents",
        "Members": [
          { "Agent": "claude", "Billing": "Subscription", "ModelId": "claude-opus-4-7", "QualityScore": 100, "Capabilities": [ "sensitive" ] },
          { "Agent": "codex", "Billing": "Subscription", "ModelId": "gpt-5.5", "QualityScore": 100, "Capabilities": [ "sensitive" ] },
          { "Agent": "cursor", "Billing": "Subscription", "ModelId": "composer-2.5", "QualityScore": 98 },
          { "Agent": "gemini", "Billing": "Subscription", "ModelId": "gemini-3-flash-preview", "QualityScore": 95, "ReasoningMode": "high" }
        ]
      }
    ],
    "AgentScoreModifiers": {
      "ByTimeOfDay": [
        {
          "Agent": "claude",
          "Modifier": -1,
          "Comment": "Anthropic peak hours (Mon-Fri 14:00-22:00 UTC): slight demotion so we lean on codex when tied. Adjust or remove to suit your billing agreement.",
          "Windows": [
            { "Days": [ "Mon", "Tue", "Wed", "Thu", "Fri" ], "StartUtc": "14:00", "EndUtc": "22:00" }
          ]
        }
      ]
    }
  }
}
