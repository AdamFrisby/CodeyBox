{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  },
  "AllowedHosts": "*",
  "CodeyBox": {
    "GitRootDirectory": "/var/lib/codeybox/repos",
    "StateDatabasePath": "/var/lib/codeybox/state.db",
    "SandboxImageReference": "codeybox/agent:latest",
    "AgentAllowedHosts": [
      "api.anthropic.com",
      "api.openai.com",
      "api.githubcopilot.com",
      "generativelanguage.googleapis.com"
    ],
    "Concurrency": 2,
    "UpstreamPushMaxAttempts": 5,
    "UpstreamPushBackoffSeconds": 15,
    "Defaults": {
      "Agent": "claude",
      "BaseBranch": "main",
      "Audit": {
        "MaxIterations": 3,
        "FailingSeverity": "Error",
        "AuditTypes": [
          "security",
          "architecture",
          "quality",
          "completeness",
          "cheating",
          "tests"
        ]
      }
    },
    "Projects": [],
    "AgentPricing": {
      "Rates": {
        "claude": {
          "claude-opus-4-7": { "inputPerMillion": 15.0, "cachedInputPerMillion": 1.50, "outputPerMillion": 75.0 },
          "claude-sonnet-4-6": { "inputPerMillion": 3.0, "cachedInputPerMillion": 0.30, "outputPerMillion": 15.0 },
          "claude-haiku-4-5": { "inputPerMillion": 0.8, "cachedInputPerMillion": 0.08, "outputPerMillion": 4.0 }
        },
        "codex": {
          "codex-5.5": { "inputPerMillion": 5.0, "cachedInputPerMillion": 0.50, "outputPerMillion": 25.0 }
        },
        "gemini": {
          "gemini-3.0-pro": { "inputPerMillion": 7.0, "cachedInputPerMillion": 0.70, "outputPerMillion": 21.0 }
        }
      },
      "DefaultRates": {}
    }
  }
}
