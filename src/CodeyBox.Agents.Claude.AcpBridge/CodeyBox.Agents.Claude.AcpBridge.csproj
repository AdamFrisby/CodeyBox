<Project Sdk="Microsoft.NET.Sdk">

  <!--
    ACP bridge native sidecar. Compiles to a self-contained, statically-linked
    ELF binary that ships into the sandbox VM and replaces the prior Node.js
    bridge (see AcpBridgeBinary.cs / AcpClaudeTransport.cs in the parent
    CodeyBox.Agents.Claude project).

    Build prerequisites for `dotnet publish`:
      - musl-tools (for the musl static linker the AOT publish step invokes).
      - The linux-musl-x64 ILCompiler runtime nuget package is restored
        on demand.

    The default `dotnet build CodeyBox.slnx` does NOT run the AOT publish;
    it just builds the IL assembly so the solution stays buildable on hosts
    without musl-tools installed. Operators run scripts/publish-acp-bridge.sh
    to produce the static binary and refresh the embedded resource carried
    by CodeyBox.Agents.Claude.
  -->

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>CodeyBox.Agents.Claude.AcpBridge</RootNamespace>
    <AssemblyName>CodeyBox.Agents.Claude.AcpBridge</AssemblyName>

    <!-- AOT settings honoured by `dotnet publish` only.
         StaticExecutable is the documented NativeAOT MSBuild property for
         producing a fully statically-linked binary against musl on the
         linux-musl-x64 RID. Verify with `file` (advertises "statically linked")
         and `ldd` ("not a dynamic executable") after running
         scripts/publish-acp-bridge.sh. -->
    <PublishAot>true</PublishAot>
    <StaticExecutable>true</StaticExecutable>
    <InvariantGlobalization>true</InvariantGlobalization>
    <StripSymbols>true</StripSymbols>
    <IlcGenerateStackTraceData>false</IlcGenerateStackTraceData>
    <IlcOptimizationPreference>Size</IlcOptimizationPreference>
    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>

    <!-- Reflection-free JSON: source-generation only. -->
    <JsonSerializerIsReflectionEnabledByDefault>false</JsonSerializerIsReflectionEnabledByDefault>

    <!-- This binary never references InternalsVisibleTo into CodeyBox.Tests
         and the solution-wide warnings-as-errors settings come from
         Directory.Build.props. Keep nullable + analysis on so any port bug
         that survives the JS → C# rewrite gets caught by the analyser. -->
  </PropertyGroup>

  <!--
    StaticExecutable=true together with PublishAot=true produces a fully-
    statically-linked ELF that has NO dlopen / dynamic-loader support at
    runtime. The default NativeAOT PInvoke resolver path is `dlopen("libc.so")`
    on first call — which throws DllNotFoundException in a fully-static
    binary. Bridge.NativeMethods.Kill (the libc kill(2) we P/Invoke for
    the polite SIGTERM-then-grace-then-SIGKILL teardown of the claude IDE
    subprocess) would therefore silently regress to bare Process.Kill
    (SIGKILL only), re-introducing the thinking-block-immutability 400
    cluster the polite SIGTERM fix was specifically added to prevent.

    DirectPInvoke tells the NativeAOT compiler to resolve the libc PInvoke
    at link time (no runtime dlopen), and NativeLibrary statically links
    libc into the executable so the kill symbol is available without a
    dynamic loader. Together these two items make the libc.kill DllImport
    work in the StaticExecutable output the same way it works in the IL
    build that the unit tests exercise via `dotnet exec`.
  -->
  <ItemGroup>
    <DirectPInvoke Include="libc" />
    <NativeLibrary Include="libc" />
  </ItemGroup>

</Project>
