{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id"
  ],
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1
    },
    "displayName": {
      "type": "string"
    },
    "llmAuditorName": {
      "type": "string"
    },
    "reviewFocus": {
      "type": "string"
    },
    "planReviewFocus": {
      "type": "string"
    },
    "targets": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "replace": {
      "type": "boolean"
    },
    "auditors": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "argv": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "script": {
            "type": "string"
          },
          "toolName": {
            "type": "string"
          },
          "treatExit127AsMissingTool": {
            "type": "boolean"
          },
          "missingToolSeverity": {
            "type": "string",
            "enum": [
              "info",
              "warning",
              "warn",
              "error"
            ]
          },
          "requiredCapabilities": {
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "network",
                "agent-credentials",
                "graphical"
              ]
            }
          },
          "canShortCircuitOnBlockingFinding": {
            "type": "boolean"
          },
          "role": {
            "type": "string",
            "enum": [
              "build-test-gate"
            ]
          },
          "gateEvidence": {
            "type": "string",
            "enum": [
              "build",
              "test",
              "build-and-test"
            ]
          }
        }
      }
    },
    "patterns": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "regex",
          "description"
        ],
        "properties": {
          "regex": {
            "type": "string",
            "minLength": 1
          },
          "description": {
            "type": "string",
            "minLength": 1
          },
          "severity": {
            "type": "string",
            "enum": [
              "info",
              "warning",
              "error"
            ]
          }
        }
      }
    }
  }
}
