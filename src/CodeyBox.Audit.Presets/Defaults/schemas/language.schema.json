{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id"
  ],
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1
    },
    "displayName": {
      "type": "string"
    },
    "replace": {
      "type": "boolean"
    },
    "marker": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "globs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "script": {
          "type": "string"
        }
      }
    },
    "auditors": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "argv": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "script": {
            "type": "string"
          },
          "toolName": {
            "type": "string"
          },
          "treatExit127AsMissingTool": {
            "type": "boolean"
          },
          "canShortCircuitOnBlockingFinding": {
            "type": "boolean"
          }
        }
      }
    }
  }
}
