<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\CodeyBox.Agents\CodeyBox.Agents.csproj" />
    <ProjectReference Include="..\CodeyBox.Core\CodeyBox.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Http" Version="10.0.7" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <!--
    ACP bridge native binary. The bridge is produced by the sibling
    CodeyBox.Agents.Claude.AcpBridge project as a self-contained, statically-
    linked NativeAOT ELF and copied into Resources/acp-bridge by
    scripts/publish-acp-bridge.sh. The Claude orchestrator-side assembly
    ships the binary as an embedded resource (LogicalName=acp-bridge); the
    runtime path materialises it inside the sandbox and execs it.

    Debug/test builds can embed the tracked Resources/acp-bridge.placeholder
    when no native resource has been generated. Release/artifact builds invoke
    scripts/publish-acp-bridge.sh by default, then must embed Resources/acp-
    bridge; otherwise the build fails rather than shipping an assembly that
    always degrades ACP to print.
  -->
  <PropertyGroup>
    <AcpBridgeResourcePath>$(MSBuildThisFileDirectory)Resources/acp-bridge</AcpBridgeResourcePath>
    <AcpBridgePlaceholderResourcePath>$(MSBuildThisFileDirectory)Resources/acp-bridge.placeholder</AcpBridgePlaceholderResourcePath>
    <PublishAcpBridgeNativeResource Condition="'$(PublishAcpBridgeNativeResource)' == '' and '$(Configuration)' == 'Release'">true</PublishAcpBridgeNativeResource>
    <PublishAcpBridgeNativeResource Condition="'$(PublishAcpBridgeNativeResource)' == ''">false</PublishAcpBridgeNativeResource>
    <RequireAcpBridgeNativeResource Condition="'$(RequireAcpBridgeNativeResource)' == '' and '$(Configuration)' == 'Release'">true</RequireAcpBridgeNativeResource>
    <RequireAcpBridgeNativeResource Condition="'$(RequireAcpBridgeNativeResource)' == ''">false</RequireAcpBridgeNativeResource>
  </PropertyGroup>

  <Target Name="PublishAcpBridgeNativeResource"
          BeforeTargets="PrepareForBuild"
          Condition="'$(PublishAcpBridgeNativeResource)' == 'true'">
    <Exec WorkingDirectory="$(MSBuildThisFileDirectory)../.."
          Command="scripts/publish-acp-bridge.sh" />
  </Target>

  <Target Name="SelectAcpBridgeEmbeddedResource"
          BeforeTargets="AssignTargetPaths">
    <Error Condition="'$(RequireAcpBridgeNativeResource)' == 'true' and !Exists('$(AcpBridgeResourcePath)')"
           Text="Release builds of CodeyBox.Agents.Claude require a real ACP bridge resource at $(AcpBridgeResourcePath). Run scripts/publish-acp-bridge.sh on a host with musl-tools and Multipass, or leave PublishAcpBridgeNativeResource enabled for Release builds." />

    <ItemGroup Condition="Exists('$(AcpBridgeResourcePath)')">
      <EmbeddedResource Include="$(AcpBridgeResourcePath)"
                        LogicalName="acp-bridge"
                        Link="Resources/acp-bridge" />
    </ItemGroup>
    <ItemGroup Condition="!Exists('$(AcpBridgeResourcePath)') and '$(RequireAcpBridgeNativeResource)' != 'true'">
      <EmbeddedResource Include="$(AcpBridgePlaceholderResourcePath)"
                        LogicalName="acp-bridge"
                        Link="Resources/acp-bridge.placeholder" />
    </ItemGroup>
  </Target>

  <ItemGroup>
    <InternalsVisibleTo Include="CodeyBox.Tests" />
  </ItemGroup>

</Project>
