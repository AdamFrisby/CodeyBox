<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\CodeyBox.Core\CodeyBox.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Pinned structured-log reader. See docs/concepts/msbuild-diagnostics.md
         ("Version support") before bumping: MSBuildDiagnosticsOptions
         MaxSupportedFileFormatVersion tracks the format version this exact
         build emits and reads. -->
    <PackageReference Include="MSBuild.StructuredLogger" Version="2.3.246" />
    <PackageReference Include="System.IO.Hashing" Version="10.0.7" />
    <PackageReference Include="Microsoft.Extensions.Options.ConfigurationExtensions" Version="10.0.7" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

</Project>
