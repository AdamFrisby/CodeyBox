<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- Sample plugin — not packaged for NuGet. -->
    <IsPackable>false</IsPackable>
    <Description>
      Sample credential-provider plugin that reads secrets from a local JSON file
      in lieu of a real vault server. Demonstrates the ICredentialProvider plugin
      pattern including ExpiresAt time-bound caching. See docs/extending/credential-plugins.md.
    </Description>
  </PropertyGroup>

  <ItemGroup>
    <!--
      Reference the PluginSdk project locally (in a real plugin, use the NuGet package):
        <PackageReference Include="CodeyBox.PluginSdk" Version="1.*" />
    -->
    <ProjectReference Include="..\..\src\CodeyBox.PluginSdk\CodeyBox.PluginSdk.csproj" />
  </ItemGroup>

</Project>
