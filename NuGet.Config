<?xml version="1.0" encoding="utf-8"?>
<!--
  Repository-pinned NuGet configuration.

  Directory.Build.props points RestoreConfigFile at this file so restore uses
  ONLY these settings and never walks up into the user-level or machine-level
  NuGet.Config hierarchy. On this fork-heavy build host, concurrent restores
  (a full-solution non-incremental build restores every project at once) can
  race the first-run bootstrap of ~/.nuget/NuGet/NuGet.Config and fail every
  project with "Failed to read NuGet.Config due to unauthorized access". Pinning
  restore to this checked-in file makes the build self-contained and immune to
  that race.

  Only the public nuget.org feed is required; the shared global packages folder
  (~/.nuget/packages) is intentionally left at its default so the existing
  package cache is reused offline.
-->
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
</configuration>
