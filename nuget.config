<?xml version="1.0" encoding="utf-8"?>
<!--
  Repository-scoped NuGet configuration.

  Pinning the package source at the repo root makes restore hermetic: the
  build resolves packages from nuget.org regardless of whatever feeds the
  machine/user-level NuGet config happens to list (or omit). <clear/> drops
  any inherited packageSources so a stray or broken machine feed cannot
  redirect or fail the restore for this solution. Global packages / fallback
  folders are intentionally left inherited so the existing package cache is
  reused.
-->
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
</configuration>
