<Project>

  <!--
    Heal a foreign-owned $HOME/.nuget BEFORE NuGet restore reads its user
    settings, so a raw `dotnet build`/`dotnet test` of this solution survives a
    sandbox that ships $HOME/.nuget owned by another uid. See
    build/heal-nuget-home.sh for the full rationale; in short, NuGet aborts every
    restore with "unauthorized access" when it cannot create $HOME/.nuget/NuGet,
    and no MSBuild property or repo nuget.config can redirect that read.

    The heal runs as an ordinary target ahead of Restore. It is guarded to POSIX
    hosts (the foreign-owned-home failure mode is Unix-specific) and is a strict
    no-op when the NuGet home is already usable, so it adds only a few syscalls
    to a healthy build. ContinueOnError keeps a repair failure from masking the
    real restore error that would follow.
  -->
  <Target Name="CodeyBoxHealNuGetHome"
          BeforeTargets="Restore;_GenerateRestoreGraph;CollectPackageReferences"
          Condition="'$(OS)' != 'Windows_NT'">
    <Exec Command="sh &quot;$(MSBuildThisFileDirectory)heal-nuget-home.sh&quot;"
          ContinueOnError="true"
          StandardOutputImportance="low" />
  </Target>

</Project>
