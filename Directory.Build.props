<Project InitialTargets="CodeyBoxHealNuGetHome">

  <!-- Heal an unwritable inherited per-user NuGet home before restore reads it.
       InitialTargets runs this at the start of every project MSBuild invocation,
       before NuGet's user-config read; the target lives in one shared file so the
       solution- and project-level hooks stay identical. During a SOLUTION build
       this per-project hook is suppressed (_CodeyBoxInSolution below) and the
       once-per-solution hook in Directory.Solution.props does the repair
       instead; outside a solution build this hook still runs per project but
       NON-destructively (CODEYBOX_NUGET_HEAL_NO_QUARANTINE) — destructive
       repair that renames a directory is reserved for the solution level, and
       an unusable home in a non-solution build is covered by the in-process
       NuGetHomeGuard.targets redirect.
       This hook resolves
       ${DOTNET_CLI_HOME:-$HOME}; the sibling hook in Directory.Build.targets
       (scripts/ensure-writable-nuget-home.sh) always resolves $HOME, so the
       two overlap harmlessly whenever DOTNET_CLI_HOME is unset. -->
  <Import Project="$(MSBuildThisFileDirectory)Directory.NuGetHomeHeal.targets" />

  <PropertyGroup Condition="'$(SolutionPath)' != '' and '$(SolutionPath)' != '*Undefined*'">
    <_CodeyBoxInSolution>true</_CodeyBoxInSolution>
  </PropertyGroup>

  <PropertyGroup>
    <!-- Direct project restores use the repository's declared package sources here.
         Directory.Solution.props supplies the same repository-relative property for
         solution restores before they dispatch work to individual projects. -->
    <RestoreConfigFile>$(MSBuildThisFileDirectory)nuget.config</RestoreConfigFile>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <AnalysisLevel>latest</AnalysisLevel>
    <!-- Suppress satellite-assembly scanning during ResolveAssemblyReference.
         This is required solution-wide because the build host is fork-heavy
         and the directory-enumeration inside RAR hits ENOMEM on multiple
         projects (not only CodeyBox.Cli). Known trade-off: non-English
         satellite assemblies from referenced packages will not be copied to
         output directories; this is acceptable because the solution has no
         non-English resource consumers. -->
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <ResolveAssemblyReferencesFindRelatedSatellites>false</ResolveAssemblyReferencesFindRelatedSatellites>
    <!-- NuGet's settings task otherwise merges the per-user config even when a
         repository config is present. An explicit path keeps project graph
         evaluation independent of the build account's home directory.
         Sandboxed agents often have a root-owned ~/.nuget parent that blocks
         creating the user-level NuGet config directory; RestoreConfigFile
         limits config discovery to this file only. Callers must also set
         DOTNET_CLI_HOME to a writable repo-local path (see
         DotnetCliHomeConventions / build.sh) because the SDK still probes the
         user config directory before RestoreConfigFile applies. -->
    <RestoreConfigFile>$(MSBuildThisFileDirectory)nuget.config</RestoreConfigFile>
    <!-- The initial target may redirect DOTNET_CLI_HOME solely for NuGet's
         user-config/proxy cache. Keep packages in the caller's original
         global cache so that redirect does not force a second package store. -->
    <_CodeyBoxOriginalDotNetHome Condition="'$(DOTNET_CLI_HOME)' != ''">$(DOTNET_CLI_HOME)</_CodeyBoxOriginalDotNetHome>
    <_CodeyBoxOriginalDotNetHome Condition="'$(_CodeyBoxOriginalDotNetHome)' == '' and '$(HOME)' != ''">$(HOME)</_CodeyBoxOriginalDotNetHome>
    <_CodeyBoxOriginalDotNetHome Condition="'$(_CodeyBoxOriginalDotNetHome)' == ''">$(USERPROFILE)</_CodeyBoxOriginalDotNetHome>
    <!-- Recorded BEFORE RestorePackagesPath is pinned below so the in-process
         NuGetHomeGuard task can tell "this value was auto-pinned by the repo"
         apart from an operator-supplied RestorePackagesPath it must never
         override. -->
    <_CodeyBoxAutoRestorePackagesPath Condition="'$(RestorePackagesPath)' == '' and '$(_CodeyBoxOriginalDotNetHome)' != ''">$([System.IO.Path]::Combine('$(_CodeyBoxOriginalDotNetHome)', '.nuget', 'packages'))</_CodeyBoxAutoRestorePackagesPath>
    <RestorePackagesPath Condition="'$(_CodeyBoxAutoRestorePackagesPath)' != ''">$(_CodeyBoxAutoRestorePackagesPath)</RestorePackagesPath>
  </PropertyGroup>

  <!-- Release identity. Declared once here so assembly metadata, the admin UI's
       reported version and scripts/package.sh's tarball name cannot disagree. -->
  <PropertyGroup>
    <VersionPrefix>0.8.1</VersionPrefix>
    <Product>CodeyBox</Product>
    <Company>Adam Frisby</Company>
    <Authors>Adam Frisby</Authors>
    <Copyright>Copyright (c) 2026 Adam Frisby</Copyright>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <RepositoryUrl>https://github.com/AdamFrisby/CodeyBox</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
  </PropertyGroup>

</Project>
