<Project InitialTargets="CodeyBoxHealNuGetHome">

  <!-- Heal an unwritable inherited per-user NuGet home before restore reads it.
       InitialTargets runs this at the start of every project MSBuild invocation,
       before NuGet's user-config read; the target lives in one shared file so the
       solution- and project-level hooks stay identical. -->
  <Import Project="$(MSBuildThisFileDirectory)Directory.NuGetHomeHeal.targets" />

  <PropertyGroup>
    <!-- Direct project restores use the repository's declared package sources here.
         Directory.Solution.props supplies the same repository-relative property for
         solution restores before they dispatch work to individual projects. -->
    <RestoreConfigFile>$(MSBuildThisFileDirectory)NuGet.Config</RestoreConfigFile>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <AnalysisLevel>latest</AnalysisLevel>
    <!-- Suppress satellite-assembly scanning during ResolveAssemblyReference.
         This is required solution-wide because the build host is fork-heavy
         and the directory-enumeration inside RAR hits ENOMEM on multiple
         projects (not only CodeyBox.Cli). Known trade-off: non-English
         satellite assemblies from referenced packages will not be copied to
         output directories; this is acceptable because the solution has no
         non-English resource consumers. -->
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <ResolveAssemblyReferencesFindRelatedSatellites>false</ResolveAssemblyReferencesFindRelatedSatellites>
  </PropertyGroup>

</Project>
