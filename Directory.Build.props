<Project>

  <PropertyGroup>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <AnalysisLevel>latest</AnalysisLevel>
    <!-- Suppress satellite-assembly scanning during ResolveAssemblyReference.
         This is required solution-wide because the build host is fork-heavy
         and the directory-enumeration inside RAR hits ENOMEM on multiple
         projects (not only CodeyBox.Cli). Known trade-off: non-English
         satellite assemblies from referenced packages will not be copied to
         output directories; this is acceptable because the solution has no
         non-English resource consumers. -->
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <ResolveAssemblyReferencesFindRelatedSatellites>false</ResolveAssemblyReferencesFindRelatedSatellites>
  </PropertyGroup>

  <ItemGroup>
    <!-- Microsoft.Data.Sqlite 10.0.x still pins SQLitePCLRaw.bundle_e_sqlite3/core
         2.1.11. SQLitePCLRaw 3.x moves the native package to SourceGear.sqlite3,
         but adopting that graph requires a Microsoft.Data.Sqlite.Core/provider
         migration rather than a safe patch bump. Keep restore unblocked until
         the Microsoft.Data.Sqlite line ships a patched native dependency. -->
    <NuGetAuditSuppress Include="https://github.com/advisories/GHSA-2m69-gcr7-jv3q" />
  </ItemGroup>

</Project>
