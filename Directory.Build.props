<Project InitialTargets="CodeyBoxHealNuGetHome;CodeyBoxReclaimNuGetHome">

  <!-- Heal an unwritable inherited per-user NuGet home before restore reads it.
       InitialTargets runs this at the start of every project MSBuild invocation,
       before NuGet's user-config read; the target lives in one shared file so the
       solution- and project-level hooks stay identical. The Reclaim target below
       is an additional belt-and-suspenders fast-path (idempotent no-op when the
       home is already writable) targeting a slightly different unwritable-home
       shape; both are wired via InitialTargets. -->
  <Import Project="$(MSBuildThisFileDirectory)Directory.NuGetHomeHeal.targets" />

  <PropertyGroup>
    <!-- Direct project restores use the repository's declared package sources here.
         Directory.Solution.props supplies the same repository-relative property for
         solution restores before they dispatch work to individual projects. -->
    <RestoreConfigFile>$(MSBuildThisFileDirectory)NuGet.Config</RestoreConfigFile>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <AnalysisLevel>latest</AnalysisLevel>
    <!-- Suppress satellite-assembly scanning during ResolveAssemblyReference.
         This is required solution-wide because the build host is fork-heavy
         and the directory-enumeration inside RAR hits ENOMEM on multiple
         projects (not only CodeyBox.Cli). Known trade-off: non-English
         satellite assemblies from referenced packages will not be copied to
         output directories; this is acceptable because the solution has no
         non-English resource consumers. -->
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <ResolveAssemblyReferencesFindRelatedSatellites>false</ResolveAssemblyReferencesFindRelatedSatellites>
    <!-- NuGet's settings task otherwise merges the per-user config even when a
         repository config is present. An explicit path keeps project graph
         evaluation independent of the build account's home directory.
         Sandboxed agents often have a root-owned ~/.nuget parent that blocks
         creating the user-level NuGet config directory; RestoreConfigFile
         limits config discovery to this file only. Callers must also set
         DOTNET_CLI_HOME to a writable repo-local path (see
         DotnetCliHomeConventions / build.sh) because the SDK still probes the
         user config directory before RestoreConfigFile applies. -->
    <RestoreConfigFile>$(MSBuildThisFileDirectory)nuget.config</RestoreConfigFile>
    <!-- The initial target may redirect DOTNET_CLI_HOME solely for NuGet's
         user-config/proxy cache. Keep packages in the caller's original
         global cache so that redirect does not force a second package store. -->
    <_CodeyBoxOriginalDotNetHome Condition="'$(DOTNET_CLI_HOME)' != ''">$(DOTNET_CLI_HOME)</_CodeyBoxOriginalDotNetHome>
    <_CodeyBoxOriginalDotNetHome Condition="'$(_CodeyBoxOriginalDotNetHome)' == '' and '$(HOME)' != ''">$(HOME)</_CodeyBoxOriginalDotNetHome>
    <_CodeyBoxOriginalDotNetHome Condition="'$(_CodeyBoxOriginalDotNetHome)' == ''">$(USERPROFILE)</_CodeyBoxOriginalDotNetHome>
    <RestorePackagesPath Condition="'$(RestorePackagesPath)' == '' and '$(_CodeyBoxOriginalDotNetHome)' != ''">$([System.IO.Path]::Combine('$(_CodeyBoxOriginalDotNetHome)', '.nuget', 'packages'))</RestorePackagesPath>
  </PropertyGroup>

  <!-- Runs BEFORE restore reads the NuGet user config within the SAME dotnet
       process, so a bare `dotnet build` (which inherits none of the
       DOTNET_CLI_HOME/HOME pinning that build.sh and SandboxRequiredBuildVerifier
       apply) can still repair a root-owned, unwritable ~/.nuget provisioned by
       some sandbox base images. The script is a fast-path no-op when the NuGet
       home is already usable (the normal developer case) and never fails the
       build. POSIX-only: the defect and its repair are Unix-permission specific.
       See scripts/reclaim-nuget-home.sh. -->
  <Target Name="CodeyBoxReclaimNuGetHome"
          Condition="'$(OS)' != 'Windows_NT' And Exists('$(MSBuildThisFileDirectory)scripts/reclaim-nuget-home.sh')">
    <Exec Command="sh &quot;$(MSBuildThisFileDirectory)scripts/reclaim-nuget-home.sh&quot;"
          StandardOutputImportance="Low"
          StandardErrorImportance="Low" />
  </Target>

  <!-- Second-line heal wired via BeforeTargets=Restore rather than InitialTargets
       so it also catches a root-owned, non-writable ~/.nuget that only becomes
       observable once the Restore target starts (see scripts/repair-nuget-home.sh
       for the full rationale). Preserves any user NuGet.Config and symlinks the
       baked packages cache so cache-only restores keep working. The script is a
       no-op on a healthy (writable/absent) ~/.nuget, so developer and CI machines
       are untouched. Non-Windows only: the defect and the userspace rename fix
       are POSIX-specific. -->
  <Target Name="RepairUnwritableNuGetHome"
          BeforeTargets="Restore;CollectPackageReferences;_GenerateRestoreProjectSpec"
          Condition="!$([MSBuild]::IsOSPlatform('Windows'))">
    <Exec Command="sh &quot;$(MSBuildThisFileDirectory)scripts/repair-nuget-home.sh&quot;"
          StandardOutputImportance="Low"
          ContinueOnError="true" />
  </Target>

</Project>
