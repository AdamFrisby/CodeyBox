<Project>

  <!--
    Heal an inherited, non-writable per-user NuGet home BEFORE `dotnet` reads it.

    A COW-inherited / baked sandbox can ship `$HOME/.nuget` owned by root (or
    otherwise unwritable), so the build user cannot create `$HOME/.nuget/NuGet/`
    and restore aborts with "Failed to read NuGet.Config due to unauthorized
    access" / "Access to the path '.../.nuget/NuGet' is denied" before any
    package is restored. NuGet performs that user-config read during restore, so
    the home must be repaired on disk before restore runs.

    This is wired through `InitialTargets`. At solution level it is imported by
    `Directory.Solution.props`, which also sets `_CodeyBoxNuGetHealSolutionLevel`
    — the ONLY invocation allowed to run the destructive quarantine (the `mv`
    that renames an unusable `.nuget` aside), once per solution before the
    solution restore dispatches per-project work. That flag is REQUIRED, not
    decorative: during the solution-node evaluation `Directory.Build.props` is
    imported too and sets `_CodeyBoxInSolution` (because `$(SolutionPath)` is
    non-empty), so without it this target's own suppression condition would
    evaluate false and the mandated once-per-solution repair would never run.

    During a solution build the per-project evaluations suppress this same
    target via `_CodeyBoxInSolution` (set in `Directory.Build.props`). For
    non-solution builds (`dotnet build foo.csproj`, `dotnet test`) the
    project-level import in `Directory.Build.props` runs it instead — but with
    `CODEYBOX_NUGET_HEAL_NO_QUARANTINE=1`, because destructive repair from a
    per-project InitialTarget is forbidden: an unusable home there is handled
    by the in-process `NuGetHomeGuard.targets` redirect (imported by
    `Directory.Build.targets`), not by renaming directories once per project.

    Either way a plain `dotnet build` / `dotnet test` / `dotnet build
    <solution>` heals itself with no wrapper script, environment override, or
    orchestrator change: the exact commands the build/test gates invoke
    directly.

    The repair itself is the single source of truth in scripts/nuget-home-heal.sh
    (also dot-sourced by build.sh and the orchestrator's audit gates). The
    settings heal and runtime-dir pinning are strict no-ops on a healthy home;
    the only writes on every evaluation are the settings dir's
    create-if-missing, the transient create-then-delete writability probe
    inside it, and the idempotent migration-marker seed described next,
    so re-running it on every project evaluation stays cheap.
    The same script seeds NuGet's applied-migration marker
    (`.local/share/NuGet/Migrations/1`) under the homes a later dotnet exec
    could resolve, so restore's MigrationRunner skips the user-scoped
    "NuGet-Migrations" named mutex — which aborts the whole build when the
    launch environment resolves no usable runtime dir ($XDG_RUNTIME_DIR or
    $HOME) — even when that marker was not planted before the dotnet process
    started.
  -->
  <PropertyGroup>
    <CodeyBoxNuGetHomeHealScript>$(MSBuildThisFileDirectory)scripts/nuget-home-heal.sh</CodeyBoxNuGetHomeHealScript>
  </PropertyGroup>

  <Target Name="CodeyBoxHealNuGetHome"
          Condition=" '$(OS)' != 'Windows_NT'
                      and '$(DesignTimeBuild)' != 'true'
                      and Exists('$(CodeyBoxNuGetHomeHealScript)')
                      and ('$(_CodeyBoxNuGetHealSolutionLevel)' == 'true'
                           or '$(_CodeyBoxInSolution)' != 'true') ">
    <!-- The script never fails a `set -e` caller and returns 0 in every path, so
         the command always exits 0 and produces no warning under
         TreatWarningsAsErrors; the trailing `|| true` is belt-and-suspenders in
         case a future edit changes that. stderr must reach the operator: the
         script is quiet on a clean home, and its diagnostics — above all the
         quarantine notice — are the only signal that the solution-level repair
         renamed an unusable .nuget aside. Exec only surfaces stderr lines that
         match the MSBuild warning/error format unless
         IgnoreStandardErrorWarningFormat is set, so it is set here and the
         importance raised to high; without both, plain stderr (the script's
         only output channel) is silently dropped at normal verbosity. -->
    <Exec Condition=" '$(_CodeyBoxNuGetHealSolutionLevel)' == 'true' "
          Command="sh -c '. &quot;$(CodeyBoxNuGetHomeHealScript)&quot; || true'"
          StandardOutputImportance="low"
          StandardErrorImportance="high"
          IgnoreStandardErrorWarningFormat="true" />
    <Exec Condition=" '$(_CodeyBoxNuGetHealSolutionLevel)' != 'true' "
          Command="sh -c 'export CODEYBOX_NUGET_HEAL_NO_QUARANTINE=1; . &quot;$(CodeyBoxNuGetHomeHealScript)&quot; || true'"
          StandardOutputImportance="low"
          StandardErrorImportance="high"
          IgnoreStandardErrorWarningFormat="true" />
  </Target>

</Project>
