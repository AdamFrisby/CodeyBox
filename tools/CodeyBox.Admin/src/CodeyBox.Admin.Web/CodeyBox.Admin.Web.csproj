<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- No project references to src/CodeyBox.* — coupling is REST+JSON only. -->
    <!-- The Admin.Model reference is tools-to-tools (pure, dependency-free
         projection layer): the web app maps its REST DTOs onto the model at
         the edge instead of re-implementing chains/attention/layout. -->
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\CodeyBox.Admin.Model\CodeyBox.Admin.Model.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- .NET SignalR client for server-side hub connection (live stdout panel). -->
    <PackageReference Include="Microsoft.AspNetCore.Authentication.Google" Version="10.0.0" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.0" />
    <PackageReference Include="Microsoft.AspNetCore.SignalR.Client" Version="10.0.0" />
    <!-- Sibling admin projection layer (pure, no I/O). Still no refs to src/CodeyBox.*. -->
    <ProjectReference Include="..\CodeyBox.Admin.Model\CodeyBox.Admin.Model.csproj" />
  </ItemGroup>

</Project>
