@inject IHttpContextAccessor HttpContextAccessor

@{
    var isAuthenticated = HttpContextAccessor.HttpContext?.User.Identity?.IsAuthenticated == true;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>CodeyBox Admin</title>
    <base href="/" />
    <link rel="stylesheet" href="css/admin.css" />
    <HeadOutlet />
</head>
<body>
    @* The login page must not start a protected Blazor circuit: the negotiate
       request would be redirected to HTML and the client expects JSON. *@
    @if (isAuthenticated)
    {
        <Routes @rendermode="@InteractiveServer" />
        <script src="_framework/blazor.web.js"></script>
        <script src="js/live-stdout.js"></script>
    }
    else
    {
        <Routes />
    }
</body>
</html>
