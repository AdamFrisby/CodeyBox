@page "/login"
@attribute [AllowAnonymous]

<PageTitle>Login Required — CodeyBox Admin</PageTitle>

<h1>Login Required</h1>
<p>
    This admin dashboard is configured to require authentication
    (<code>CodeyBoxAdmin:RequireAuth=true</code>).
</p>
<p>
    Access is controlled via cookie authentication. If you believe you should have access,
    contact your administrator to obtain credentials.
</p>
