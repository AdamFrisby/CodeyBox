    private CreateWorkItemRequest ToRequest(PlannedCreate planned, IEnumerable<string>? extraDependsOn = null) =>
        new()
        {
            ProjectId = planned.ProjectId,
            ExternalId = planned.ExternalId,
            Title = planned.Title,
            Prompt = planned.Prompt,
            Agent = planned.Agent,
            AuditorProfile = planned.AuditorProfile,
            AgentClassId = planned.AgentClassId,
            BaseBranch = planned.BaseBranch,
            WorkBranch = planned.WorkBranch,
            PushUpstream = planned.PushUpstream,
            Priority = planned.Priority,
            MinModelScore = planned.MinModelScore,
            RequiredCapabilities = planned.RequiredCapabilities?.ToList(),
            AuditMaxIterations = planned.AuditMaxIterations,
            AuditComplexity = planned.AuditComplexity,
            Knobs = planned.Knobs is null ? null : new Dictionary<string, string>(planned.Knobs, StringComparer.Ordinal),
            ReleaseId = planned.ReleaseId,
            DependsOn = [.. (extraDependsOn ?? []), .. planned.DependsOn],
        };

    private void HandleInvalidSubmit()
    {
        if (string.IsNullOrWhiteSpace(_projectId.Value))
        {
            _projectError = "Project is required.";
        }
    }

    private async Task SubmitAsync()
    {
        _submitting = true;
        _error = null;
        _projectError = null;
        try
        {
            if (string.IsNullOrWhiteSpace(_projectId.Value))
            {
                _projectError = "Project is required.";
                return;
            }

            if (string.IsNullOrWhiteSpace(_form.Title))
            {
                _error = "Title is required.";
                return;
            }

            if (string.IsNullOrWhiteSpace(_form.Prompt))
            {
                _error = "Prompt is required.";
                return;
            }

            var defaults = ComposerDefaults();
            var planned = WorkItemChainBuilder.Build(
                defaults,
                [new ChainItemDraft(_form.Title.Trim(), _form.Prompt, [], BlankToNull(_form.ExternalId))],
                NewChainKey());
            var created = await ApiClient.CreateWorkItemAsync(ToRequest(planned[0], _selectedDeps));
            if (created is not null)
            {
                Nav.NavigateTo($"/work-items/{created.Id}");
            }
            else
            {
                _error = "Failed to create work item.";
            }
        }
        catch (FormatException ex)
        {
            _error = ex.Message;
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _submitting = false;
        }
    }

    private async Task SubmitChainAsync()
    {
        _submitting = true;
        _error = null;
        _projectError = null;
        try
        {
            if (string.IsNullOrWhiteSpace(_projectId.Value))
            {
                _projectError = "Project is required.";
                return;
            }

            if (_preview.Count == 0)
            {
                _error = "Parse a plan first — there is nothing to file.";
                return;
            }

            var empty = _preview.FindIndex(d => string.IsNullOrWhiteSpace(d.Title));
            if (empty >= 0)
            {
                _error = $"Item {empty + 1} needs a title before filing.";
                return;
            }

            var defaults = ComposerDefaults();
            var drafts = _preview
                .Select(d => new ChainItemDraft(
                    d.Title.Trim(), d.Body, d.Deps.OrderBy(n => n).ToList()))
                .ToList();
            var planned = WorkItemChainBuilder.Build(defaults, drafts, NewChainKey());
            var requests = planned
                .Select((p, i) => ToRequest(p, i == 0 ? _chainExternalDeps : null))
                .ToList();
            var result = await ApiClient.CreateWorkItemChainAsync(requests);
            if (result.Succeeded)
            {
                Nav.NavigateTo($"/work-items/{result.Created[0].Id}");
                return;
            }

            var createdIds = string.Join(", ", result.Created.Select(c => c.ShortId));
            _error = result.FailedIndex is null
                ? $"Chain failed: {result.Error}"
                : $"Filed {result.Created.Count} of {requests.Count} before item {result.FailedIndex + 1} failed: {result.Error}"
                  + (result.Created.Count > 0 ? $" Created: {createdIds}. The preview is untouched — fix and re-file the remainder." : string.Empty);
        }
        catch (FormatException ex)
        {
            _error = ex.Message;
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _submitting = false;
        }
    }

    private async Task SubmitChainKeyDown(KeyboardEventArgs e)
    {
        if ((e.Key is "Enter" or " ") && !_submitting && _preview.Count > 0)
        {
            await SubmitChainAsync();
        }
    }

    private async Task QueueTemplateAsync(TaskTemplateDto template)
    {
        _submitting = true;
        _templateMessage = null;
        _error = null;
        try
        {
            if (string.IsNullOrWhiteSpace(_projectId.Value))
            {
                _projectError = "Project is required.";
                return;
            }

            var response = await ApiClient.QueueTaskTemplateAsync(new QueueTaskTemplateRequest
            {
                Template = template.Name,
                ProjectId = _projectId.Value,
                Agent = BlankToNull(_agent.Value),
                AgentClassId = BlankToNull(_agentClassId.Value),
            });
            _templateMessage = response is null
                ? $"Queueing '{template.Name}' failed."
                : $"Queued {response.Enqueued} {(response.Enqueued == 1 ? "item" : "items")} from '{template.Name}'.";
        }
        catch (Exception ex)
        {
            _templateMessage = $"Queueing '{template.Name}' failed: {ex.Message}";
        }
        finally
        {
            _submitting = false;
        }
    }

    private async Task PromoteSuggestionAsync()
    {
        _submitting = true;
        _error = null;
        try
        {
            var workItemId = await ApiClient.PromoteSuggestionAsync(
                _fromSuggestionId!,
                extraInstructions: string.IsNullOrWhiteSpace(_form.Prompt) ? null : _form.Prompt,
                agent: BlankToNull(_agent.Value),
                workBranch: string.IsNullOrWhiteSpace(_form.WorkBranch) ? null : _form.WorkBranch,
                pushUpstream: _form.PushUpstream,
                externalId: string.IsNullOrWhiteSpace(_form.ExternalId) ? null : _form.ExternalId.Trim());
            if (workItemId is not null)
            {
                Nav.NavigateTo($"/work-items/{workItemId}");
            }
            else
            {
                _error = "Failed to promote suggestion.";
            }
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _submitting = false;
        }
    }

    private static string NewChainKey() =>
        Guid.NewGuid().ToString("N")[..8];

    private static string? BlankToNull(string? value) =>
        string.IsNullOrWhiteSpace(value) ? null : value.Trim();

