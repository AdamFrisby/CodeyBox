@page "/work-items/new"
@using CodeyBox.Admin.Model
@using CodeyBox.Admin.Web.Models
@inject ICodeyBoxApiClient ApiClient
@inject NavigationManager Nav

<PageTitle>@Heading — CodeyBox Admin</PageTitle>

@* The composer is an editor with an inspector, not a form. The substance —
   what the agent will read, and how the pieces depend on each other — is
   the wide column. Every option the create surface accepts is in the rail
   beside it, grouped, each showing its value and where the value came
   from. Nothing is hidden behind a disclosure; nothing shouts. Structure
   is read from the text as it is typed: a numbered plan becomes a chain
   outline, a long prompt with sections stays one item, and either default
   is one click from the other. Nothing is created until File. *@

<div class="composer">
    <header class="composer-head">
        <h1>@Heading</h1>
        @if (_fromSuggestionData is not null)
        {
            <p class="composer-context">
                Promoting <strong>@_fromSuggestionData.Title</strong>
                (<span class="category-badge">@_fromSuggestionData.Category</span>
                / <StatusChip Info="@StatusVocabulary.ForSeverity(_fromSuggestionData.Severity)" />).
                Its title and rationale lead the prompt; anything you write here follows them.
            </p>
        }
        @if (_followUpItem is not null)
        {
            <p class="composer-context">
                Follows <a href="/work-items/@_followUpItem.Id"><strong>@_followUpItem.Title</strong></a>
                (@_followUpItem.ShortId). The relationship is inferred — it will wait for that item — but the words are yours.
            </p>
        }
    </header>

    @if (_error is not null)
    {
        <p class="error-banner" id="composer-error">@_error</p>
    }

    @if (!_loaded)
    {
        <p>Loading…</p>
    }
    else
    {
        <div class="composer-body">
            <main class="composer-main">
                @if (_fromSuggestionId is null && !IsChain)
                {
                    <div class="field-row">
                        <label for="title">
                            Title
                            <span class="set-src">@(_titleDerived ? "from the first line" : "you")</span>
                        </label>
                        <input id="title" class="form-control composer-title" value="@_title"
                               placeholder="Derived from the first line of the prompt"
                               @onchange="e => OnTitleTyped(e.Value?.ToString() ?? string.Empty)" />
                    </div>
                }

                <div class="field-row composer-editor-row">
                    <label for="prompt">
                        @(_fromSuggestionId is not null ? "Additional instructions" : "Prompt")
                        <span class="set-src">@(_fromSuggestionId is not null ? "optional" : "or paste a plan — numbered steps become a chain")</span>
                    </label>
                    <textarea id="prompt" class="form-control prompt-input composer-editor" rows="18"
                              placeholder="@EditorPlaceholder"
                              @bind="_text" @bind:event="oninput" @bind:after="OnTextChanged"
                              @onkeydown="OnEditorKeyDown"></textarea>
                </div>

                @if (_fromSuggestionId is null && _parsed.Items.Count > 1)
                {
                    <div class="structure-strip" id="structure-strip" role="group" aria-label="How to file this text">
                        <span class="structure-reading">
                            @(_parsed.Confidence == PlanConfidence.Structured
                                ? $"Reads as a plan of {_parsed.Items.Count} items."
                                : $"Has {_parsed.Items.Count} sections — probably one item.")
                        </span>
                        <span class="seg" role="radiogroup" aria-label="File as">
                            <button type="button" id="file-as-one" class="seg-btn @(IsChain ? string.Empty : "seg-btn--on")"
                                    role="radio" aria-checked="@(IsChain ? "false" : "true")" @onclick="() => SetChain(false)">One item</button>
                            <button type="button" id="file-as-chain" class="seg-btn @(IsChain ? "seg-btn--on" : string.Empty)"
                                    role="radio" aria-checked="@(IsChain ? "true" : "false")" @onclick="() => SetChain(true)">Chain of @_parsed.Items.Count</button>
                        </span>
                    </div>
                }

                @if (IsChain)
                {
                    <ChainOutline Items="_outline" Changed="OnOutlineChanged" />
                }

                @if (_fromSuggestionId is null)
                {
                    <section class="field-row" aria-label="Existing dependencies">
                        <label for="dep-search">
                            Waits for existing items
                            <span class="set-src">@(IsChain ? "applied to the chain's roots" : "optional")</span>
                        </label>
                        <DependencyPicker Candidates="OrderedCandidates()" AllCandidates="AllCandidates()"
                                          Selected="_existingDeps" Search="@_depSearch"
                                          SearchChanged="v => _depSearch = v" Toggle="ToggleExistingDep"
                                          IdPrefix="dep-" SearchInputId="dep-search" ProjectName="ProjectDisplayName" />
                    </section>
                }

                <section class="review" aria-label="Review">
                    @if (_fromSuggestionId is null)
                    {
                        <p class="review-sentence" id="review-sentence">@ReviewSentence</p>
                        @if (Problems.Count > 0)
                        {
                            <ul class="review-problems" id="review-problems">
                                @foreach (var p in Problems)
                                {
                                    <li>@p</li>
                                }
                            </ul>
                        }
                    }
                    <div class="form-actions review-actions">
                        @if (_fromSuggestionId is not null)
                        {
                            <button type="button" id="file" class="btn btn-primary" disabled="@_submitting" @onclick="PromoteSuggestionAsync">
                                @(_submitting ? "Promoting…" : "Promote to work item")
                            </button>
                            <a href="/suggestions/@_fromSuggestionId" class="btn">Cancel</a>
                        }
                        else
                        {
                            <button type="button" id="file" class="btn btn-primary" disabled="@(_submitting || Problems.Count > 0)" @onclick="FileAsync">
                                @FileLabel
                            </button>
                            <a href="/" class="btn">Cancel</a>
                            <span class="review-hint">Ctrl+Enter files from the editor.</span>
                        }
                    </div>
                </section>
            </main>

            <aside class="composer-rail" aria-label="Settings">
                <div class="set-group">
                    <h3>Where</h3>
                    <div class="set-row">
                        <label for="project">Project <span class="set-src">@SourceLabel(_projectId)</span></label>
                        <select id="project" class="form-control" value="@(_projectId.Value ?? string.Empty)"
                                @onchange="e => OnProjectSelected(e.Value?.ToString())">
                            <option value="">— select —</option>
                            @foreach (var p in _projects)
                            {
                                <option value="@p.Id">@p.DisplayName</option>
                            }
                        </select>
                    </div>
                    <div class="set-row">
                        <label for="baseBranch">Base branch <span class="set-src">@SourceLabel(_baseBranch)</span></label>
                        <div class="set-ctl">
                            <input id="baseBranch" class="form-control" value="@(_baseBranch.Value ?? string.Empty)" placeholder="project default"
                                   @onchange="e => _baseBranch = _baseBranch.SetOperator(BlankToNull(e.Value?.ToString()))" />
                            @if (_baseBranch.Overridden)
                            {
                                <button type="button" id="reset-baseBranch" class="set-reset" title="Back to the inferred value" @onclick="ResetBaseBranch">↺</button>
                            }
                        </div>
                    </div>
                    <div class="set-row">
                        <label for="workBranch">Work branch</label>
                        <input id="workBranch" class="form-control" @bind="_workBranch" placeholder="auto-generated" />
                    </div>
                    <div class="set-row set-row--check">
                        <input type="checkbox" id="pushUpstream" @bind="_pushUpstream" />
                        <label for="pushUpstream">Push upstream after merge</label>
                    </div>
                    @if (_fromSuggestionId is null)
                    {
                        <div class="set-row">
                            <label for="release">Release</label>
                            <select id="release" class="form-control" @bind="_releaseId">
                                <option value="">none</option>
                                @foreach (var r in _openReleases.Where(r => r.ProjectId == _projectId.Value))
                                {
                                    <option value="@r.Id">@r.Name</option>
                                }
                            </select>
                        </div>
                    }
                </div>

                <div class="set-group">
                    <h3>Who</h3>
                    <div class="set-row">
                        <label for="agent">Agent <span class="set-src">@SourceLabel(_agent)</span></label>
                        <div class="set-ctl">
                            <select id="agent" class="form-control" value="@(_agent.Value ?? string.Empty)"
                                    @onchange="e => _agent = _agent.SetOperator(BlankToNull(e.Value?.ToString()))">
                                <option value="">project default</option>
                                @foreach (var a in AgentOptions)
                                {
                                    <option value="@a.Value">@a.Label</option>
                                }
                            </select>
                            @if (_agent.Overridden)
                            {
                                <button type="button" id="reset-agent" class="set-reset" title="Back to the inferred value" @onclick="ResetAgent">↺</button>
                            }
                        </div>
                    </div>
                    <div class="set-row">
                        <label for="agentClass">Agent class <span class="set-src">@SourceLabel(_agentClassId)</span></label>
                        <div class="set-ctl">
                            <input id="agentClass" class="form-control" value="@(_agentClassId.Value ?? string.Empty)" placeholder="route by agent"
                                   title="When set, the class routes by score and quota and the agent above is not consulted."
                                   @onchange="e => OnAgentClassChanged(e.Value?.ToString())" />
                            @if (_agentClassId.Overridden)
                            {
                                <button type="button" id="reset-agentClass" class="set-reset" title="Back to the inferred value" @onclick="ResetAgentClass">↺</button>
                            }
                        </div>
                    </div>
                    @if (_fromSuggestionId is null)
                    {
                        <div class="set-row">
                            <label for="requiredCapabilities">Required capabilities</label>
                            <input id="requiredCapabilities" class="form-control" @bind="_capabilitiesText" placeholder="gpu, large-mem" />
                        </div>
                        <div class="set-row">
                            <label for="minModelScore">Min model score</label>
                            <input id="minModelScore" class="form-control set-num" inputmode="numeric" @bind="_minModelScoreText" placeholder="any" />
                        </div>
                    }
                </div>

                @if (_fromSuggestionId is null)
                {
                    <div class="set-group">
                        <h3>Audit</h3>
                        <div class="set-row">
                            <label for="auditMaxIterations">Iterations <span class="set-src">@SourceLabel(_auditBudgetText)</span></label>
                            <div class="set-ctl">
                                <input id="auditMaxIterations" class="form-control set-num" inputmode="numeric"
                                       value="@(_auditBudgetText.Value ?? string.Empty)" placeholder="project default"
                                       @onchange="e => OnBudgetChanged(e.Value?.ToString())" />
                                @if (_auditBudgetText.Overridden)
                                {
                                    <button type="button" id="reset-auditMaxIterations" class="set-reset" title="Back to the inferred value" @onclick="ResetBudget">↺</button>
                                }
                            </div>
                        </div>
                        <div class="set-row">
                            <label for="auditorProfile">Auditor profile <span class="set-src">@SourceLabel(_auditorProfile)</span></label>
                            <input id="auditorProfile" class="form-control" value="@(_auditorProfile.Value ?? string.Empty)" placeholder="default"
                                   @onchange="e => _auditorProfile = _auditorProfile.SetOperator(BlankToNull(e.Value?.ToString()))" />
                        </div>
                        <div class="set-row">
                            <label for="auditComplexity">Complexity</label>
                            <input id="auditComplexity" class="form-control" @bind="_auditComplexity" placeholder="server default" />
                        </div>
                    </div>

                    <div class="set-group">
                        <h3>Queue</h3>
                        <div class="set-row">
                            <label for="priority">Priority</label>
                            <input id="priority" class="form-control set-num" inputmode="numeric" @bind="_priorityText" placeholder="0"
                                   title="Higher is picked up sooner; -1000 to 1000." />
                        </div>
                        <div class="set-row set-row--check">
                            <input type="checkbox" id="isRefactor" @bind="_isRefactor" />
                            <label for="isRefactor" title="Runs alone: starts only when the project has nothing else in flight, and blocks other starts while it runs.">Refactor (project-exclusive)</label>
                        </div>
                        <div class="set-row set-row--pair">
                            <label for="workTimeout">Timeouts <span class="set-src">minutes</span></label>
                            <span class="set-pair">
                                <input id="workTimeout" class="form-control set-num" inputmode="numeric" @bind="_workTimeoutText" placeholder="work" aria-label="Work timeout in minutes" />
                                <input id="mergeTimeout" class="form-control set-num" inputmode="numeric" @bind="_mergeTimeoutText" placeholder="merge" aria-label="Merge timeout in minutes" />
                            </span>
                        </div>
                    </div>

                    <div class="set-group">
                        <h3>Knobs</h3>
                        @foreach (var knob in KnobCatalog.BuiltIn)
                        {
                            var key = knob.Key;
                            <div class="set-row">
                                <label for="knob-@key" title="@knob.Description">@knob.Label</label>
                                <select id="knob-@key" class="form-control" value="@(_knobSelections.GetValueOrDefault(key) ?? string.Empty)"
                                        @onchange="e => _knobSelections[key] = e.Value?.ToString()">
                                    <option value="">@knob.DefaultValue (default)</option>
                                    @foreach (var v in knob.AllowedValues.Where(v => v != knob.DefaultValue))
                                    {
                                        <option value="@v">@v</option>
                                    }
                                </select>
                            </div>
                        }
                        <div class="set-row set-row--stack">
                            <label for="knobs">More knobs <span class="set-src">key=value per line</span></label>
                            <textarea id="knobs" class="form-control prompt-input set-knobs" rows="2" @bind="_extraKnobsText"></textarea>
                        </div>
                    </div>
                }

                @if (!IsChain)
                {
                    <div class="set-group">
                        <h3>Identity</h3>
                        <div class="set-row">
                            <label for="externalId">External id</label>
                            <input id="externalId" class="form-control" @bind="_externalId" placeholder="JIRA-1234" />
                        </div>
                    </div>
                }
                else
                {
                    <p class="set-note">Chain members get generated external ids so they can name each other.</p>
                }
            </aside>
        </div>

        @if (_fromSuggestionId is null && _templates.Count > 0)
        {
            <footer class="composer-templates" id="templates">
                <label for="template-pick">Or queue a task template for this project</label>
                <select id="template-pick" class="form-control" @bind="_templatePick">
                    @foreach (var t in _templates)
                    {
                        <option value="@t.Name" disabled="@(t.Error is not null)">
                            @t.Name@(t.CheckCount is { } n ? $" ({n} checks)" : string.Empty)@(t.Error is not null ? " — unavailable" : string.Empty)
                        </option>
                    }
                </select>
                <button type="button" id="queue-template" class="btn btn-sm"
                        disabled="@(_submitting || string.IsNullOrWhiteSpace(_projectId.Value) || string.IsNullOrWhiteSpace(_templatePick))"
                        title="@(string.IsNullOrWhiteSpace(_projectId.Value) ? "Pick a project first" : "Queue the template's items for the selected project")"
                        @onclick="QueueTemplateAsync">Queue</button>
                @if (_templateMessage is not null)
                {
                    <span class="template-message" id="template-message">@_templateMessage</span>
                }
            </footer>
        }
    }
</div>

@code {
    [SupplyParameterFromQuery]
    public string? FromSuggestion { get; set; }

    [SupplyParameterFromQuery(Name = "projectId")]
    public string? QueryProjectId { get; set; }

    [SupplyParameterFromQuery(Name = "agent")]
    public string? QueryAgent { get; set; }

    [SupplyParameterFromQuery(Name = "baseBranch")]
    public string? QueryBaseBranch { get; set; }

    [SupplyParameterFromQuery(Name = "followUp")]
    public string? QueryFollowUp { get; set; }

    [SupplyParameterFromQuery(Name = "agentClassId")]
    public string? QueryAgentClassId { get; set; }

    [SupplyParameterFromQuery(Name = "auditorProfile")]
    public string? QueryAuditorProfile { get; set; }

    [SupplyParameterFromQuery(Name = "auditBudget")]
    public int? QueryAuditBudget { get; set; }

    private static readonly IReadOnlyList<(string Value, string Label)> CuratedAgents =
    [
        ("claude", "claude"),
        ("copilot", "copilot"),
        ("codex", "codex"),
        ("gemini", "gemini"),
        ("cursor", "cursor"),
        ("opencode", "opencode"),
    ];

    // ── loaded context ──────────────────────────────────────────────────
    private bool _loaded;
    private List<ProjectDto> _projects = [];
    private List<WorkItemDto> _candidates = [];
    private List<TaskTemplateDto> _templates = [];
    private List<ReleaseDto> _openReleases = [];
    private List<AgentAvailabilityDto> _availableAgents = [];
    private string? _fromSuggestionId;
    private SuggestionDto? _fromSuggestionData;
    private WorkItemDto? _followUpItem;

    // ── inferred settings (value + provenance) ──────────────────────────
    private InferredField<string> _projectId = InferredField<string>.Empty;
    private InferredField<string> _agent = InferredField<string>.Empty;
    private InferredField<string> _baseBranch = InferredField<string>.Empty;
    private InferredField<string> _agentClassId = InferredField<string>.Empty;
    private InferredField<string> _auditorProfile = InferredField<string>.Empty;
    private InferredField<string> _auditBudgetText = InferredField<string>.Empty;

    // ── plain settings ──────────────────────────────────────────────────
    private string _workBranch = "";
    private bool _pushUpstream = true;
    private string _releaseId = "";
    private string _capabilitiesText = "";
    private string _minModelScoreText = "";
    private string _auditComplexity = "";
    private string _priorityText = "";
    private bool _isRefactor;
    private string _workTimeoutText = "";
    private string _mergeTimeoutText = "";
    private readonly Dictionary<string, string?> _knobSelections = new(StringComparer.Ordinal);
    private string _extraKnobsText = "";
    private string _externalId = "";

    // ── substance ───────────────────────────────────────────────────────
    private string _title = "";
    private bool _titleDerived = true;
    private string _text = "";
    private ParsedPlan _parsed = new([], false);
    private bool? _chainChoice;
    private readonly List<ComposerOutlineItem> _outline = [];
    private readonly HashSet<string> _existingDeps = new(StringComparer.Ordinal);
    private string _depSearch = "";

    // ── review + filing ─────────────────────────────────────────────────
    private string? _error;
    private bool _submitting;
    private string _templatePick = "";
    private string? _templateMessage;

    private string Heading =>
        _fromSuggestionId is not null ? "Promote suggestion"
        : _followUpItem is not null ? "Follow-up work"
        : "New work";

    private bool IsChain => _fromSuggestionId is null && _parsed.Items.Count > 1
        && (_chainChoice ?? _parsed.Confidence == PlanConfidence.Structured);

    private string EditorPlaceholder => _fromSuggestionId is not null
        ? "Anything the agent should know beyond the suggestion itself."
        : "Describe the work. Paste a numbered plan — “1. …”, “## 2. …”, “depends on: 1, 3” — to file a chain in one go.";

    private string FileLabel =>
        _submitting ? "Filing…"
        : IsChain ? $"File {_outline.Count} items"
        : _isRefactor ? "File refactor"
        : "File";

    /// <summary>
    /// The agents on offer: the live availability list when there is one,
    /// else the curated kinds. The inferred or chosen value is always an
    /// option even when the fleet does not list it right now, so the select
    /// can show what the request will actually carry.
    /// </summary>
    private IReadOnlyList<(string Value, string Label)> AgentOptions
    {
        get
        {
            var options = _availableAgents.Count == 0
                ? CuratedAgents.ToList()
                : _availableAgents
                    .OrderBy(a => a.Excluded)
                    .ThenBy(a => a.Agent, StringComparer.Ordinal)
                    .Select(a => (Value: a.Agent, Label: a.Excluded ? $"{a.Agent} (unavailable)" : a.Agent))
                    .ToList();
            if (_agent.Value is { Length: > 0 } current && options.All(o => o.Value != current))
            {
                options.Insert(0, (current, $"{current} (not in the fleet list)"));
            }

            return options;
        }
    }

    private string ProjectDisplayName(string projectId) =>
        _projects.FirstOrDefault(p => p.Id == projectId)?.DisplayName ?? projectId;

    // ── load + infer ────────────────────────────────────────────────────
    protected override async Task OnInitializedAsync()
    {
        try
        {
            _projects = await ApiClient.GetProjectsAsync();
            var all = await ApiClient.GetWorkItemsAsync();
            _candidates = all.Where(i => !i.IsTerminal).ToList();
            _templates = await ApiClient.GetTaskTemplatesAsync();
            _templatePick = _templates.FirstOrDefault(t => t.Error is null)?.Name ?? "";
            _openReleases = await ApiClient.GetReleasesAsync(state: "Open", limit: 100);
            _availableAgents = await ApiClient.GetAgentAvailabilityAsync();

            if (!string.IsNullOrEmpty(FromSuggestion))
            {
                var suggestion = await ApiClient.GetSuggestionAsync(FromSuggestion);
                if (suggestion is not null)
                {
                    _fromSuggestionId = FromSuggestion;
                    _fromSuggestionData = suggestion;
                }
                else
                {
                    _error = $"Suggestion '{FromSuggestion}' not found.";
                }
            }

            if (!string.IsNullOrWhiteSpace(QueryFollowUp))
            {
                _followUpItem = _candidates.FirstOrDefault(i => i.Id == QueryFollowUp)
                    ?? await ApiClient.GetWorkItemAsync(QueryFollowUp);
                if (_followUpItem is not null)
                {
                    _existingDeps.Add(_followUpItem.Id);
                }
            }

            var recent = all.OrderByDescending(i => i.CreatedAt).FirstOrDefault()?.ProjectId;
            var project = ComposerInference.ResolveProject(
                QueryProjectId, _fromSuggestionData?.ProjectId, _followUpItem?.ProjectId, recent,
                _projects.Select(p => p.Id).ToList());
            _projectId = _projectId.ApplyInferred(project.Value, project.Source);

            ApplyProjectDefaults();
            ApplyQueryOverrides();
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _loaded = true;
        }
    }

    private void ApplyProjectDefaults()
    {
        var project = _projects.FirstOrDefault(p => p.Id == _projectId.Value);
        if (project is null)
        {
            return;
        }

        _agent = _agent.ApplyInferred(BlankToNull(project.DefaultAgent), ComposerFieldSource.ProjectDefault);
        _baseBranch = _baseBranch.ApplyInferred(BlankToNull(project.DefaultBaseBranch), ComposerFieldSource.ProjectDefault);
        _agentClassId = _agentClassId.ApplyInferred(BlankToNull(project.DefaultAgentClass), ComposerFieldSource.ProjectDefault);
        var budget = ComposerInference.ResolveAuditBudget(null, project.AuditMaxIterations);
        _auditBudgetText = _auditBudgetText.ApplyInferred(budget.Value?.ToString(), budget.Source);
    }

    private void ApplyQueryOverrides()
    {
        if (!string.IsNullOrWhiteSpace(QueryAgent))
        {
            _agent = _agent.ApplyInferred(QueryAgent.Trim(), ComposerFieldSource.Query);
        }

        if (!string.IsNullOrWhiteSpace(QueryBaseBranch))
        {
            _baseBranch = _baseBranch.ApplyInferred(QueryBaseBranch.Trim(), ComposerFieldSource.Query);
        }

        if (!string.IsNullOrWhiteSpace(QueryAgentClassId))
        {
            _agentClassId = _agentClassId.ApplyInferred(QueryAgentClassId.Trim(), ComposerFieldSource.Query);
        }

        if (!string.IsNullOrWhiteSpace(QueryAuditorProfile))
        {
            _auditorProfile = _auditorProfile.ApplyInferred(QueryAuditorProfile.Trim(), ComposerFieldSource.Query);
        }

        if (QueryAuditBudget is { } b && b > 0)
        {
            _auditBudgetText = _auditBudgetText.ApplyInferred(b.ToString(), ComposerFieldSource.Query);
        }
    }

    private void OnProjectSelected(string? value)
    {
        _projectId = _projectId.SetOperator(BlankToNull(value));
        _releaseId = "";
        ApplyProjectDefaults();
        ApplyQueryOverrides();
    }

    private (string? Value, ComposerFieldSource Source) Inference(string? queryValue, Func<ProjectDto, string?> pick)
    {
        var project = _projects.FirstOrDefault(p => p.Id == _projectId.Value);
        return ComposerInference.ResolveText(queryValue, project is null ? null : pick(project));
    }

    private void ResetAgent()
    {
        var (v, s) = Inference(QueryAgent, p => p.DefaultAgent);
        _agent = _agent.ResetToInferred(v, s);
    }

    private void ResetBaseBranch()
    {
        var (v, s) = Inference(QueryBaseBranch, p => p.DefaultBaseBranch);
        _baseBranch = _baseBranch.ResetToInferred(v, s);
    }

    private void ResetAgentClass()
    {
        var (v, s) = Inference(QueryAgentClassId, p => p.DefaultAgentClass);
        _agentClassId = _agentClassId.ResetToInferred(v, s);
    }

    private void OnAgentClassChanged(string? value)
    {
        var v = BlankToNull(value);
        if (v is null)
        {
            ResetAgentClass();
        }
        else
        {
            _agentClassId = _agentClassId.SetOperator(v);
        }
    }

    private void ResetBudget()
    {
        var project = _projects.FirstOrDefault(p => p.Id == _projectId.Value);
        var (v, s) = ComposerInference.ResolveAuditBudget(QueryAuditBudget, project?.AuditMaxIterations ?? 0);
        _auditBudgetText = _auditBudgetText.ResetToInferred(v?.ToString(), s);
    }

    private void OnBudgetChanged(string? value)
    {
        var v = BlankToNull(value);
        if (v is null)
        {
            ResetBudget();
        }
        else
        {
            _auditBudgetText = _auditBudgetText.SetOperator(v);
        }
    }

    private static string SourceLabel(InferredField<string> field) => field.Overridden ? "you" : field.Source switch
    {
        ComposerFieldSource.Query => "from link",
        ComposerFieldSource.ProjectDefault => "project default",
        ComposerFieldSource.FollowUp => "follow-up",
        ComposerFieldSource.Suggestion => "suggestion",
        ComposerFieldSource.Recent => "most recent item",
        ComposerFieldSource.Operator => "you",
        _ => string.IsNullOrWhiteSpace(field.Value) ? "not set" : string.Empty,
    };

    // ── substance: text → title, structure, outline ─────────────────────
    private void OnTitleTyped(string value)
    {
        _title = value;
        _titleDerived = string.IsNullOrWhiteSpace(value);
        if (_titleDerived)
        {
            _title = ComposerInference.DeriveTitle(_text);
        }
    }

    private void OnTextChanged()
    {
        if (_titleDerived)
        {
            _title = ComposerInference.DeriveTitle(_text);
        }

        var before = _parsed.Items.Count;
        _parsed = PlanChainParser.Parse(_text);
        if (_parsed.Items.Count != before)
        {
            _chainChoice = null;
        }

        RebuildOutline();
    }

    /// <summary>
    /// Re-derives the outline from the parse. Titles and bodies the
    /// operator edited in the outline survive while the item count is
    /// unchanged; so do edges, unless the parse now carries explicit ones.
    /// </summary>
    private void RebuildOutline()
    {
        var items = _parsed.Items;
        var sameCount = _outline.Count == items.Count;
        var fresh = new List<ComposerOutlineItem>(items.Count);
        for (var i = 0; i < items.Count; i++)
        {
            var parsed = items[i];
            var old = sameCount ? _outline[i] : null;
            var edges = old is not null && !_parsed.HadExplicitEdges ? old.Edges : parsed.DependsOn.ToList();
            fresh.Add(new ComposerOutlineItem
            {
                Title = old is { TitleEdited: true } ? old.Title : parsed.Title,
                Body = old is { BodyEdited: true } ? old.Body : parsed.Body,
                TitleEdited = old?.TitleEdited ?? false,
                BodyEdited = old?.BodyEdited ?? false,
                Expanded = old?.Expanded ?? false,
                Edges = edges.ToList(),
                EdgesText = ChainEdges.Format(edges),
            });
        }

        _outline.Clear();
        _outline.AddRange(fresh);
    }

    private void SetChain(bool chain) => _chainChoice = chain;

    private Task OnOutlineChanged() => InvokeAsync(StateHasChanged);

    private async Task OnEditorKeyDown(KeyboardEventArgs e)
    {
        if ((e.CtrlKey || e.MetaKey) && e.Key == "Enter" && !_submitting)
        {
            if (_fromSuggestionId is not null)
            {
                await PromoteSuggestionAsync();
            }
            else if (Problems.Count == 0)
            {
                await FileAsync();
            }
        }
    }

    // ── dependencies ────────────────────────────────────────────────────
    private List<DependencyCandidate> AllCandidates() => _candidates.Select(ToCandidate).ToList();

    private List<DependencyCandidate> OrderedCandidates() =>
        DependencyProximity.Order(
                _candidates.Select(ToCandidate).Where(c => DependencyProximity.Matches(c, _depSearch)),
                _projectId.Value,
                _existingDeps)
            .ToList();

    private static DependencyCandidate ToCandidate(WorkItemDto item) =>
        new(item.Id, item.ProjectId, item.Title, item.State, item.CreatedAt, item.ExternalId);

    private void ToggleExistingDep(string id, bool selected)
    {
        if (selected)
        {
            _existingDeps.Add(id);
        }
        else
        {
            _existingDeps.Remove(id);
        }
    }

    // ── review ──────────────────────────────────────────────────────────
    private IReadOnlyList<string> Problems => BuildComposition().Problems;

    private string ReviewSentence
    {
        get
        {
            var (composition, _) = BuildComposition();
            return CompositionReview.Describe(
                composition,
                _projectId.Value is { } id ? ProjectDisplayName(id) : null,
                id => _candidates.FirstOrDefault(c => c.Id == id)?.ShortId ?? (id.Length >= 8 ? id[..8] : id));
        }
    }

    /// <summary>
    /// Everything on the page as one value plus the reasons it cannot be
    /// filed yet. Field parse errors are problems, not exceptions, so the
    /// review can list them beside the structural ones.
    /// </summary>
    private (Composition Composition, IReadOnlyList<string> Problems) BuildComposition()
    {
        var problems = new List<string>();
        var (extras, extrasProblem) = KnobCatalog.ParseLines(_extraKnobsText);
        if (extrasProblem is not null)
        {
            problems.Add(extrasProblem);
        }

        var (knobs, knobProblem) = KnobCatalog.Compose(_knobSelections, extras);
        if (knobProblem is not null)
        {
            problems.Add(knobProblem);
        }

        var defaults = new ComposerDefaults(
            ProjectId: _projectId.Value ?? string.Empty,
            Agent: BlankToNull(_agent.Value),
            AgentClassId: BlankToNull(_agentClassId.Value),
            BaseBranch: BlankToNull(_baseBranch.Value),
            WorkBranch: BlankToNull(_workBranch),
            PushUpstream: _pushUpstream,
            Priority: ParseInt(_priorityText, "Priority", problems),
            MinModelScore: ParseInt(_minModelScoreText, "Min model score", problems),
            RequiredCapabilities: CapabilityTags.Parse(_capabilitiesText),
            AuditMaxIterations: ParseInt(_auditBudgetText.Value, "Audit iterations", problems),
            AuditComplexity: BlankToNull(_auditComplexity),
            AuditorProfile: BlankToNull(_auditorProfile.Value),
            Knobs: knobs,
            ReleaseId: BlankToNull(_releaseId),
            WorkTimeoutMinutes: ParseInt(_workTimeoutText, "Work timeout", problems),
            MergeTimeoutMinutes: ParseInt(_mergeTimeoutText, "Merge timeout", problems),
            IsRefactor: _isRefactor);

        var items = IsChain
            ? _outline.Select(o => new ChainItemDraft(o.Title.Trim(), o.Body, o.Edges)).ToList()
            : string.IsNullOrWhiteSpace(_text) && string.IsNullOrWhiteSpace(_title)
                ? []
                : [new ChainItemDraft(_title.Trim(), _text, [], BlankToNull(_externalId))];

        var composition = new Composition(defaults, items, _existingDeps.ToList());
        problems.AddRange(CompositionReview.Validate(composition));
        if (IsChain)
        {
            problems.AddRange(_outline
                .Select((o, i) => o.EdgeProblem is null ? null : $"Item {i + 1}: {o.EdgeProblem}")
                .Where(p => p is not null)!);
        }

        return (composition, problems);
    }

    private static int? ParseInt(string? text, string field, List<string> problems)
    {
        if (string.IsNullOrWhiteSpace(text))
        {
            return null;
        }

        if (int.TryParse(text.Trim(), out var n))
        {
            return n;
        }

        problems.Add($"{field} must be a whole number.");
        return null;
    }

    // ── filing ──────────────────────────────────────────────────────────
    private async Task FileAsync()
    {
        var (composition, problems) = BuildComposition();
        if (problems.Count > 0)
        {
            _error = problems[0];
            return;
        }

        _submitting = true;
        _error = null;
        try
        {
            var planned = WorkItemChainBuilder.Build(
                composition.Defaults, composition.Items, NewChainKey(), composition.ExistingDependsOn);
            var requests = planned.Select(ToRequest).ToList();

            if (requests.Count == 1)
            {
                var created = await ApiClient.CreateWorkItemAsync(requests[0]);
                if (created is null)
                {
                    _error = "The orchestrator returned nothing — the item was not created.";
                    return;
                }

                Nav.NavigateTo($"/work-items/{created.Id}");
                return;
            }

            var result = await ApiClient.CreateWorkItemChainAsync(requests);
            if (result.Succeeded)
            {
                Nav.NavigateTo($"/work-items/{result.Created[0].Id}");
                return;
            }

            var createdIds = string.Join(", ", result.Created.Select(c => c.ShortId));
            _error = result.FailedIndex is null
                ? $"Chain failed: {result.Error}"
                : $"Filed {result.Created.Count} of {requests.Count} before item {result.FailedIndex + 1} failed: {result.Error}"
                  + (result.Created.Count > 0
                      ? $" Created: {createdIds}. The outline is untouched — remove the filed items and file the remainder."
                      : string.Empty);
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _submitting = false;
        }
    }

    private static CreateWorkItemRequest ToRequest(PlannedCreate planned) => new()
    {
        ProjectId = planned.ProjectId,
        ExternalId = planned.ExternalId,
        Title = planned.Title,
        Prompt = planned.Prompt,
        Agent = planned.Agent,
        AuditorProfile = planned.AuditorProfile,
        AgentClassId = planned.AgentClassId,
        BaseBranch = planned.BaseBranch,
        WorkBranch = planned.WorkBranch,
        PushUpstream = planned.PushUpstream,
        Priority = planned.Priority,
        MinModelScore = planned.MinModelScore,
        RequiredCapabilities = planned.RequiredCapabilities?.ToList(),
        AuditMaxIterations = planned.AuditMaxIterations,
        AuditComplexity = planned.AuditComplexity,
        Knobs = planned.Knobs is null ? null : new Dictionary<string, string>(planned.Knobs, StringComparer.Ordinal),
        ReleaseId = planned.ReleaseId,
        DependsOn = planned.DependsOn.ToList(),
        WorkTimeoutMinutes = planned.WorkTimeoutMinutes,
        MergeTimeoutMinutes = planned.MergeTimeoutMinutes,
        IsRefactor = planned.IsRefactor ? true : null,
    };

    private async Task PromoteSuggestionAsync()
    {
        _submitting = true;
        _error = null;
        try
        {
            if (CompositionReview.ExternalIdProblem(_externalId) is { } idProblem)
            {
                _error = $"External id {idProblem}.";
                return;
            }

            var workItemId = await ApiClient.PromoteSuggestionAsync(
                _fromSuggestionId!,
                extraInstructions: BlankToNull(_text),
                agent: BlankToNull(_agent.Value),
                workBranch: BlankToNull(_workBranch),
                baseBranch: BlankToNull(_baseBranch.Value),
                pushUpstream: _pushUpstream,
                agentClassId: BlankToNull(_agentClassId.Value),
                externalId: BlankToNull(_externalId));
            if (workItemId is not null)
            {
                Nav.NavigateTo($"/work-items/{workItemId}");
            }
            else
            {
                _error = "Failed to promote suggestion.";
            }
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _submitting = false;
        }
    }

    private async Task QueueTemplateAsync()
    {
        var template = _templates.FirstOrDefault(t => t.Name == _templatePick);
        if (template is null || string.IsNullOrWhiteSpace(_projectId.Value))
        {
            return;
        }

        _submitting = true;
        _templateMessage = null;
        try
        {
            var response = await ApiClient.QueueTaskTemplateAsync(new QueueTaskTemplateRequest
            {
                Template = template.Name,
                ProjectId = _projectId.Value,
                Agent = BlankToNull(_agent.Value),
                AgentClassId = BlankToNull(_agentClassId.Value),
            });
            _templateMessage = response is null
                ? $"Queueing '{template.Name}' failed."
                : $"Queued {response.Enqueued} {(response.Enqueued == 1 ? "item" : "items")} from '{template.Name}'.";
        }
        catch (Exception ex)
        {
            _templateMessage = $"Queueing '{template.Name}' failed: {ex.Message}";
        }
        finally
        {
            _submitting = false;
        }
    }

    private static string NewChainKey() => Guid.NewGuid().ToString("N")[..8];

    private static string? BlankToNull(string? value) =>
        string.IsNullOrWhiteSpace(value) ? null : value.Trim();
}
