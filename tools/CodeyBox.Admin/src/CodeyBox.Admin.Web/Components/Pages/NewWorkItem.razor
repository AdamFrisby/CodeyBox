    private List<DependencyCandidate> OrderedCandidates(IReadOnlySet<string> selected)
    {
        var query = _depSearch;
        return DependencyProximity.Order(
                _candidates
                    .Where(c => DependencyProximity.Matches(ToCandidate(c), query))
                    .Select(ToCandidate),
                _projectId.Value,
                selected)
            .ToList();
    }

    private static DependencyCandidate ToCandidate(WorkItemDto item) =>
        new(item.Id, item.ProjectId, item.Title, item.State, item.CreatedAt, item.ExternalId);

