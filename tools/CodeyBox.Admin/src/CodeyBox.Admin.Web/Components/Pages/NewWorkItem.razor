    private void ParsePlan()
    {
        // Idempotent: re-firing (keyboard + native button activation both
        // land here) must not wipe preview edits, so a repeated parse of
        // unchanged text is a no-op.
        if (_planText == _lastParsedText && _preview.Count > 0)
        {
            return;
        }

        _error = null;
        try
        {
            var parsed = PlanChainParser.Parse(_planText);
            _preview.Clear();
            foreach (var item in parsed.Items)
            {
                _preview.Add(new PreviewDraft
                {
                    Title = item.Title,
                    Body = item.Body,
                    Deps = item.DependsOn.ToHashSet(),
                });
            }

            _lastParsedText = _planText;
            _previewInfo = _preview.Count == 0
                ? "Nothing to file — paste a plan first."
                : _preview.Count == 1
                    ? "Parsed 1 item. Review it below — nothing is created until you file it."
                    : parsed.HadExplicitEdges
                        ? $"Parsed {_preview.Count} items with explicit dependencies. Review the edges — nothing is created until you file."
                        : $"Parsed {_preview.Count} items as a straight-line chain. Adjust the edges if needed — nothing is created until you file.";
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
    }

    private Task ParsePlanKeyDown(KeyboardEventArgs e)
    {
        if (e.Key is "Enter" or " ")
        {
            ParsePlan();
        }

        return Task.CompletedTask;
    }

    private void TogglePreviewDep(int itemIndex, int depNumber, bool selected)
    {
        var item = _preview[itemIndex];
        if (selected)
        {
            item.Deps.Add(depNumber);
        }
        else
        {
            item.Deps.Remove(depNumber);
        }
    }

    private void RemovePreviewItem(int index)
    {
        var removedNumber = index + 1;
        _preview.RemoveAt(index);
        foreach (var item in _preview)
        {
            item.Deps.Remove(removedNumber);
            item.Deps = item.Deps
                .Select(d => d > removedNumber ? d - 1 : d)
                .ToHashSet();
        }
    }

    private string EdgeSummary(int index)
    {
        var item = _preview[index];
        var parts = new List<string>();
        if (item.Deps.Count > 0)
        {
            parts.Add("chain: " + string.Join(", ", item.Deps.OrderBy(d => d)));
        }

        if (index == 0 && _chainExternalDeps.Count > 0)
        {
            var titles = _chainExternalDeps
                .Select(id => _candidates.FirstOrDefault(c => c.Id == id))
                .Where(c => c is not null)
                .Select(c => c!.ShortId)
                .ToList();
            parts.Add("existing: " + (titles.Count > 0 ? string.Join(", ", titles) : $"{_chainExternalDeps.Count} items"));
        }

        return parts.Count == 0 ? "first in chain" : "waits for " + string.Join("; ", parts);
    }

    private ComposerDefaults ComposerDefaults() => new(
        ProjectId: _projectId.Value ?? string.Empty,
        Agent: BlankToNull(_agent.Value),
        AgentClassId: BlankToNull(_agentClassId.Value),
        BaseBranch: BlankToNull(_baseBranch.Value),
        WorkBranch: BlankToNull(_form.WorkBranch),
        PushUpstream: _form.PushUpstream,
        Priority: ParseOptionalInt(_priorityText, "Priority"),
        MinModelScore: ParseOptionalInt(_minModelScoreText, "Min model score"),
        RequiredCapabilities: ParseCapabilities(_requiredCapabilitiesText),
        AuditMaxIterations: ParseBudget(),
        AuditComplexity: BlankToNull(_auditComplexity),
        AuditorProfile: BlankToNull(_auditorProfile.Value),
        Knobs: ParseKnobs(_knobsText),
        ReleaseId: BlankToNull(_releaseId));

    private int? ParseBudget()
    {
        var text = BlankToNull(_auditBudgetText.Value);
        if (text is null)
        {
            return null;
        }

        if (!int.TryParse(text, out var n) || n <= 0)
        {
            throw new FormatException("Audit iterations must be a positive whole number.");
        }

        return n;
    }

    private static int? ParseOptionalInt(string text, string fieldName)
    {
        if (string.IsNullOrWhiteSpace(text))
        {
            return null;
        }

        if (!int.TryParse(text.Trim(), out var n))
        {
            throw new FormatException($"{fieldName} must be a whole number.");
        }

        return n;
    }

    private static List<string>? ParseCapabilities(string text)
    {
        var tags = text.Split([',', ';', '\n'], StringSplitOptions.RemoveEmptyEntries)
            .Select(t => t.Trim())
            .Where(t => t.Length > 0)
            .Distinct(StringComparer.OrdinalIgnoreCase)
            .ToList();
        return tags.Count == 0 ? null : tags;
    }

    private static Dictionary<string, string>? ParseKnobs(string text)
    {
        Dictionary<string, string>? knobs = null;
        foreach (var rawLine in text.Split('\n'))
        {
            var line = rawLine.Trim();
            if (line.Length == 0)
            {
                continue;
            }

            var eq = line.IndexOf('=');
            if (eq <= 0 || eq == line.Length - 1)
            {
                throw new FormatException($"Knob line '{line}' must look like key=value.");
            }

            knobs ??= new Dictionary<string, string>(StringComparer.Ordinal);
            knobs[line[..eq].Trim()] = line[(eq + 1)..].Trim();
        }

        return knobs;
    }

