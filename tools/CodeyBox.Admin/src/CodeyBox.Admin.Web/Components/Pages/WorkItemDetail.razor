@page "/work-items/{Id}"
@inject ICodeyBoxApiClient ApiClient
@inject NavigationManager Nav
@inject ILogger<WorkItemDetail> Logger

<PageTitle>Work Item — CodeyBox Admin</PageTitle>

@if (_notFound)
{
    <p class="error-banner">Work item not found.</p>
}
else if (_error is not null)
{
    <p class="error-banner">@_error</p>
}
else if (_item is null)
{
    <p>Loading…</p>
}
else
{
    <h1>@_item.Title</h1>

    <div class="detail-actions">
        @if (_item.IsQueued)
        {
            <a href="/work-items/@_item.Id/edit" class="btn">Edit</a>
        }
        <a href="/work-items/@_item.Id/timeline" class="btn">Timeline</a>
        <a href="/work-items/@_item.Id/audit-reports" class="btn">Audit Reports</a>
        <a href="/work-items/@_item.Id/timings" class="btn">Timings</a>
        <a href="/work-items/@_item.Id/costs" class="btn">Costs</a>
        @if (_item.IsTerminal)
        {
            <a href="/work-items/@_item.Id/comparison" class="btn">Comparison</a>
            <button class="btn" @onclick="OpenReplayModal">Replay</button>
        }
        @if (!_item.IsTerminal)
        {
            <button class="btn btn-danger" @onclick="CancelAsync">Cancel</button>
        }
        @if (_item.State is "Failed" or "AuditFailed" or "Cancelled")
        {
            <button class="btn" @onclick="RetryFromWork">Retry from work</button>
            <button class="btn" @onclick="RetryFromAudit">Retry from audit</button>
        }
    </div>

    <table class="detail-table">
        <tr><th>ID</th><td><code>@_item.Id</code></td></tr>
        @if (_item.ExternalId is not null)
        {
            <tr><th>External ID</th><td><code>@_item.ExternalId</code></td></tr>
        }
        <tr><th>Project</th><td>@_item.ProjectId</td></tr>
        <tr><th>Agent</th><td>@_item.Agent</td></tr>
        <tr><th>State</th><td class="state-@_item.State.ToLowerInvariant()">@_item.State</td></tr>
        <tr><th>Base branch</th><td>@(_item.BaseBranch ?? "(project default)")</td></tr>
        <tr><th>Work branch</th><td>@(_item.WorkBranch ?? "(auto-generated)")</td></tr>
<tr><th>Created</th><td>@_item.CreatedAt.ToString("O")</td></tr>
        <tr><th>Updated</th><td>@_item.UpdatedAt.ToString("O")</td></tr>
        <tr><th>Age</th><td>@_item.Age</td></tr>
        @if (_item.UpstreamPushAttempts > 0)
        {
            <tr><th>Push attempts</th><td>@_item.UpstreamPushAttempts</td></tr>
        }
        @if (_item.LastError is not null)
        {
            <tr><th>Last error</th><td class="last-error">@_item.LastError</td></tr>
        }
        @if (_item.ReplayOfWorkItemId is not null)
        {
            <tr>
                <th>Replay of</th>
                <td><a href="/work-items/@_item.ReplayOfWorkItemId">@_item.ReplayOfWorkItemId[..Math.Min(8, _item.ReplayOfWorkItemId.Length)]</a></td>
            </tr>
        }
        @if (_item.DependsOn.Count > 0)
        {
            <tr>
                <th>Depends on</th>
                <td>
                    @foreach (var dep in _item.DependsOn)
                    {
                        var extId = _item.DependsOnExternalIds.TryGetValue(dep, out var eid) ? eid : null;
                        var label = extId ?? dep[..Math.Min(8, dep.Length)];
                        <a href="/work-items/@dep" title="@dep">@label</a><span> </span>
                    }
                    @(_item.DependsOnSatisfied ? "(satisfied)" : "(waiting)")
                </td>
            </tr>
        }
    </table>

    <details class="prompt-collapsible">
        <summary>Prompt</summary>
        <pre class="prompt-text">@_item.Prompt</pre>
    </details>
}

@if (_showReplayModal && _item is not null)
{
    <div class="modal-overlay">
        <div class="modal-box">
            <h2>Replay on different agent</h2>
            @if (_replayError is not null)
            {
                <p class="error-banner">@_replayError</p>
            }
            <div class="form-group">
                <label>Agent</label>
                <select class="modal-input" @bind="_replayAgent">
                    <option value="">— keep current (@_item.Agent) —</option>
                    <option value="claude">claude</option>
                    <option value="codex">codex</option>
                    <option value="copilot">copilot</option>
                    <option value="gemini">gemini</option>
                </select>
            </div>
            <div class="form-group">
                <label>Agent class ID <span class="hint">(optional — routes to a class that specifies the model)</span></label>
                <input class="modal-input" type="text" placeholder="e.g. frontier-coding" @bind="_replayAgentClassId" />
            </div>
            <div class="form-group">
                <label>Work branch <span class="hint">(optional, auto-generated if blank)</span></label>
                <input class="modal-input" type="text" placeholder="auto-generated" @bind="_replayWorkBranch" />
            </div>
            <div class="modal-actions">
                <button class="btn btn-danger" @onclick="ConfirmReplayAsync">Create replay</button>
                <button class="btn" @onclick="CloseReplayModal">Cancel</button>
            </div>
        </div>
    </div>
}

@code {
    [Parameter] public string Id { get; set; } = "";

    private WorkItemDto? _item;
    private string? _error;
    private bool _notFound;
    private string? _loadedId;

    private bool _showReplayModal;
    private string? _replayAgent;
    private string? _replayAgentClassId;
    private string? _replayWorkBranch;
    private string? _replayError;

    protected override async Task OnParametersSetAsync()
    {
        if (Id == _loadedId) return;
        _loadedId = Id;
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _error = null;
        _notFound = false;
        try
        {
            _item = await ApiClient.GetWorkItemAsync(Id);
            _notFound = _item is null;
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to load work item {Id}", Id);
            _error = "Failed to load work item. Check server logs for details.";
        }
    }

    private async Task CancelAsync()
    {
        await ApiClient.DeleteWorkItemAsync(Id);
        await LoadAsync();
    }

    private Task RetryFromWork() => RetryAsync("work");
    private Task RetryFromAudit() => RetryAsync("audit");

    private async Task RetryAsync(string from)
    {
        await ApiClient.RetryWorkItemAsync(Id, from);
        await LoadAsync();
    }

    private void OpenReplayModal()
    {
        _replayAgent = null;
        _replayAgentClassId = null;
        _replayWorkBranch = null;
        _replayError = null;
        _showReplayModal = true;
    }

    private void CloseReplayModal()
    {
        _showReplayModal = false;
        _replayError = null;
    }

    private async Task ConfirmReplayAsync()
    {
        _replayError = null;
        var req = new ReplayWorkItemRequest
        {
            Agent = string.IsNullOrWhiteSpace(_replayAgent) ? null : _replayAgent,
            AgentClassId = string.IsNullOrWhiteSpace(_replayAgentClassId) ? null : _replayAgentClassId,
            WorkBranch = string.IsNullOrWhiteSpace(_replayWorkBranch) ? null : _replayWorkBranch,
        };

        var result = await ApiClient.ReplayWorkItemAsync(Id, req);
        if (result is null)
        {
            _replayError = "Failed to create replay. Check that agent is valid and the source item is in a terminal state.";
            return;
        }

        _showReplayModal = false;
        Nav.NavigateTo($"/work-items/{result.Id}");
    }
}
