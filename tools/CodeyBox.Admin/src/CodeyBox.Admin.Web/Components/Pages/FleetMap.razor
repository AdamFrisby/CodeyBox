    private async Task ResumeAutoAsync()
    {
        if (_camera is not null)
        {
            _camera = CameraDirector.ResumeAuto(_camera, DateTimeOffset.UtcNow);
            if (_projection is not null && _layout is not null)
            {
                _camera = CameraDirector.Next(_camera, _projection, _layout, DateTimeOffset.UtcNow, _viewSize, MapOptions.CurrentValue, _reducedMotion, _snapshot);
            }
        }
        await PushFrameAsync();
    }

    private async Task OverviewAsync()
    {
        if (_camera is not null && _layout is not null)
        {
            _camera = CameraDirector.Overview(_camera, _layout, DateTimeOffset.UtcNow, _viewSize, MapOptions.CurrentValue);
        }
        await PushFrameAsync();
    }

    private async Task OpenFromListAsync(string id)
    {
        if (_camera is not null && _layout is not null)
        {
            _camera = CameraDirector.OpenItem(_camera, id, _layout, DateTimeOffset.UtcNow, MapOptions.CurrentValue);
        }
        await PushFrameAsync();
    }

    [JSInvokable]
    public async Task OnManualViewport(double x, double y, double zoom)
    {
        var viewport = new CameraViewport
        {
            CenterX = double.IsFinite(x) ? x : 0,
            CenterY = double.IsFinite(y) ? y : 0,
            Zoom = double.IsFinite(zoom) && zoom > 0 ? Math.Min(8, zoom) : 1,
        };
        _camera = _camera is null
            ? new CameraState { Manual = true, Viewport = viewport, LastChangeAt = DateTimeOffset.UtcNow }
            : CameraDirector.ApplyManual(_camera, viewport, DateTimeOffset.UtcNow, _layout, MapOptions.CurrentValue, _viewSize);
        await PushFrameAsync();
        StateHasChanged();
    }

    /// <summary>A node (or a blocker's name) was clicked: travel to it and grow it.</summary>
    [JSInvokable]
    public async Task OnNodeActivated(string id)
    {
        if (_camera is null || _layout is null || !IsKnownId(id))
        {
            return;
        }
        _camera = CameraDirector.OpenItem(_camera, id, _layout, DateTimeOffset.UtcNow, MapOptions.CurrentValue);
        await PushFrameAsync();
        StateHasChanged();
    }

    /// <summary>A bubble's control was pressed: detail overlay, add dependent, answer, or a confirmed mutation.</summary>
    [JSInvokable]
    public async Task OnNodeAction(string id, string action)
    {
        if (!IsKnownId(id) || string.IsNullOrEmpty(action) || action.Length > 32)
        {
            return;
        }
        switch (action)
        {
            case "detail":
            case "answer":
                await ShowDetailAsync(id);
                break;
            case "addDependent":
                await BeginAddDependentAsync(id);
                break;
            case "menu":
                _menuFor = id;
                break;
            default:
                var known = MapItemActions.For(ItemState(id)).FirstOrDefault(a => string.Equals(a.Key, action, StringComparison.Ordinal));
                if (known is not null)
                {
                    _confirm = new PendingConfirm(id, known);
                }
                break;
        }
        StateHasChanged();
    }

    /// <summary>A suggestion ghost's control was pressed: promote, dismiss, or go to its parent.</summary>
    [JSInvokable]
    public async Task OnGhostAction(string suggestionId, string action)
    {
        if (string.IsNullOrEmpty(suggestionId) || suggestionId.Length > 128)
        {
            return;
        }
        var suggestion = _suggestions.FirstOrDefault(sg => string.Equals(sg.Id, suggestionId, StringComparison.Ordinal));
        if (suggestion is null)
        {
            return;
        }
        switch (action)
        {
            case "parent":
                await OnNodeActivated(suggestion.ParentId);
                return;
            case "promote":
            case "dismiss":
                _ghostExtra = string.Empty;
                _ghostConfirm = new GhostConfirm(suggestion.Id, action, suggestion.Title, TitleOf(suggestion.ParentId), suggestion.Severity, suggestion.Category, suggestion.Effort, suggestion.Rationale);
                break;
        }
        StateHasChanged();
    }

    private async Task RunGhostActionAsync()
    {
        var pending = _ghostConfirm;
        if (pending is null || _ghostBusy)
        {
            return;
        }
        _ghostBusy = true;
        try
        {
            if (pending.Action == "promote")
            {
                var createdId = await ApiClient.PromoteSuggestionAsync(pending.Id, string.IsNullOrWhiteSpace(_ghostExtra) ? null : _ghostExtra.Trim());
                if (createdId is null)
                {
                    _notice = $"Promote “{pending.Title}”: the orchestrator refused.";
                }
                else
                {
                    _notice = $"Promoted “{pending.Title}” — it is now real work, depending on “{pending.ParentTitle}”.";
                    _suggestionsAt = DateTimeOffset.MinValue;
                    await PollAsync();
                    if (_camera is not null && _layout is not null && _layout.Nodes.ContainsKey(createdId))
                    {
                        _camera = CameraDirector.OpenItem(_camera, createdId, _layout, DateTimeOffset.UtcNow, MapOptions.CurrentValue);
                        await PushFrameAsync();
                    }
                }
            }
            else
            {
                await ApiClient.DismissSuggestionAsync(pending.Id, string.IsNullOrWhiteSpace(_ghostExtra) ? "Dismissed from the map" : _ghostExtra.Trim());
                _notice = $"Dismissed “{pending.Title}”.";
                _suggestionsAt = DateTimeOffset.MinValue;
                await PollAsync();
            }
            _ghostConfirm = null;
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "Fleet map: suggestion action failed");
            _notice = $"{(pending.Action == "promote" ? "Promote" : "Dismiss")} “{pending.Title}”: failed. Check server logs.";
            _ghostConfirm = null;
        }
        finally
        {
            _ghostBusy = false;
        }
    }

    [JSInvokable]
    public async Task OnCloseItem()
    {
        if (_overlayId is not null || _addFor is not null || _confirm is not null || _menuFor is not null || _ghostConfirm is not null)
        {
            _overlayId = null;
            _addFor = null;
            _confirm = null;
            _menuFor = null;
            _ghostConfirm = null;
        }
        else if (_camera is not null)
        {
            _camera = CameraDirector.CloseItem(_camera, DateTimeOffset.UtcNow, MapOptions.CurrentValue);
            await PushFrameAsync();
        }
        StateHasChanged();
    }

    [JSInvokable]
    public void OnCanvasSize(double width, double height)
    {
        if (width > 0 && height > 0 && width <= 16384 && height <= 16384)
        {
            _viewSize = new CameraViewSize(width, height);
        }
    }

    [JSInvokable]
    public void OnReducedMotionChanged(bool reduced)
    {
        _reducedMotion = reduced;
        InvokeAsync(StateHasChanged);
    }

    // ── Overlay ─────────────────────────────────────────────────────────

    private Task ShowDetailAsync(string id)
    {
        if (IsKnownId(id))
        {
            _overlayId = id;
        }
        return Task.CompletedTask;
    }

    private Task CloseOverlayAsync()
    {
        _overlayId = null;
        return Task.CompletedTask;
    }

    private async Task NavigateOverlayAsync(string id)
    {
        if (!IsKnownId(id))
        {
            _notice = $"“{TitleOf(id)}” is not on the map (it has landed and folded away, or is not in flight).";
            return;
        }
        _overlayId = id;
        await OpenFromListAsync(id);
    }

    // ── Mutation: add a dependent ───────────────────────────────────────

    private Task BeginAddDependentAsync(string parentId)
    {
        if (!IsKnownId(parentId))
        {
            return Task.CompletedTask;
        }
        _addFor = parentId;
        _addForTitle = TitleOf(parentId);
        _addTitle = string.Empty;
        _addPrompt = string.Empty;
        _addAgent = _dtos.TryGetValue(parentId, out var dto) && !string.IsNullOrWhiteSpace(dto.Agent) ? dto.Agent : KnownAgents().FirstOrDefault() ?? string.Empty;
        _addError = null;
        _addBusy = false;
        _overlayId = null;
        return Task.CompletedTask;
    }

    private void CancelAddDependent()
    {
        _addFor = null;
        _addError = null;
    }

    private async Task SubmitAddDependentAsync()
    {
        if (_addFor is null || !CanSubmitAdd || !_dtos.TryGetValue(_addFor, out var parent))
        {
            _addError = _addFor is null ? null : "The parent item is no longer on the map.";
            return;
        }
        _addBusy = true;
        _addError = null;
        try
        {
            var created = await ApiClient.CreateWorkItemAsync(new CreateWorkItemRequest
            {
                ProjectId = parent.ProjectId,
                Title = _addTitle.Trim(),
                Prompt = _addPrompt.Trim(),
                Agent = string.IsNullOrWhiteSpace(_addAgent) ? null : _addAgent,
                DependsOn = [parent.Id],
            });
            if (created is null)
            {
                _addError = "The orchestrator did not create the item. Check that the project accepts new work.";
                return;
            }
            _notice = $"Created “{created.Title}” — it waits on “{parent.Title}”.";
            _addFor = null;
            await PollAsync();
            if (_camera is not null && _layout is not null && _layout.Nodes.ContainsKey(created.Id))
            {
                _camera = CameraDirector.OpenItem(_camera, created.Id, _layout, DateTimeOffset.UtcNow, MapOptions.CurrentValue);
                await PushFrameAsync();
            }
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "Fleet map: create dependent failed");
            _addError = "Creating the item failed. Check server logs for details.";
        }
        finally
        {
            _addBusy = false;
        }
    }

    private IEnumerable<string> KnownAgents()
    {
        var agents = _dtos.Values
            .Select(i => i.Agent)
            .Where(a => !string.IsNullOrWhiteSpace(a))
            .Distinct(StringComparer.OrdinalIgnoreCase)
            .OrderBy(a => a, StringComparer.OrdinalIgnoreCase)
            .ToList();
        if (!string.IsNullOrWhiteSpace(_addAgent) && !agents.Contains(_addAgent, StringComparer.OrdinalIgnoreCase))
        {
            agents.Insert(0, _addAgent);
        }
        return agents;
    }

    // ── Mutation: confirmed actions ─────────────────────────────────────

    private async Task RunConfirmedAsync()
    {
        var pending = _confirm;
        _confirm = null;
        if (pending is null)
        {
            return;
        }
        try
        {
            var ok = pending.Action.Key switch
            {
                "retryWork" => await ApiClient.RetryWorkItemAsync(pending.Id, "work"),
                "retryAudit" => await ApiClient.RetryWorkItemAsync(pending.Id, "audit"),
                "cancel" => await ApiClient.DeleteWorkItemAsync(pending.Id),
                "delegate" => await ApiClient.DelegateWorkItemAsync(pending.Id),
                _ => false,
            };
            _notice = ok
                ? $"{pending.Action.Label} · “{TitleOf(pending.Id)}”: done."
                : $"{pending.Action.Label} · “{TitleOf(pending.Id)}”: the orchestrator refused.";
            if (ok)
            {
                _detailCache.Remove(pending.Id);
                await PollAsync();
            }
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "Fleet map: action failed");
            _notice = $"{pending.Action.Label} · “{TitleOf(pending.Id)}”: failed. Check server logs.";
        }
    }

    private static string ConfirmText(MapItemAction action) => action.Key switch
    {
        "cancel" => "Cancel this item? Dependents stay queued and will never start.",
        "retryWork" => "Retry from work? The current branch is abandoned and the item re-queues.",
        "retryAudit" => "Retry from audit? The existing work branch is audited again.",
        "delegate" => "Delegate one repair turn to a delegate agent?",
        _ => $"{action.Label}?",
    };

    public void Dispose()
    {
        _cts?.Cancel();
        _cts?.Dispose();
        _dotNetRef?.Dispose();
    }

    // ── Text helpers ────────────────────────────────────────────────────

    private bool IsKnownId(string? id) =>
        !string.IsNullOrEmpty(id) && id.Length <= 128
        && _snapshot?.Items.Any(i => string.Equals(i.Id, id, StringComparison.Ordinal)) == true;

    private string ItemState(string id) =>
        _snapshot?.Items.FirstOrDefault(i => string.Equals(i.Id, id, StringComparison.Ordinal))?.State ?? string.Empty;

    private ItemActivity? ActivityOf(string id) =>
        _activities is not null && _activities.TryGetValue(id, out var activity) ? activity : null;

    /// <summary>The name is the handle: an item's title, falling back to its short id only when it has none.</summary>
    private string TitleOf(string id)
    {
        var title = _snapshot?.Items.FirstOrDefault(i => string.Equals(i.Id, id, StringComparison.Ordinal))?.Title;
        return string.IsNullOrWhiteSpace(title) ? ShortId(id) : title.Trim();
    }

    private static string ShortId(string id) => id.Length >= 8 ? id[..8] : id;

    private string ChainName(WorkChain chain) =>
        chain.SeriesPrefix is { Length: > 0 } prefix ? prefix : ChainLabel(_projection, _snapshot, chain.Id, bare: true);

    private static string DescribeFocus(CameraState? camera, FleetProjection? projection, FleetSnapshot? snapshot)
    {
        if (camera is null)
        {
            return "Loading…";
        }
        if (camera.OpenItemId is { } openId)
        {
            var title = snapshot?.Items.FirstOrDefault(i => i.Id == openId)?.Title;
            var name = string.IsNullOrWhiteSpace(title) ? ShortId(openId) : title.Trim();
            var verb = camera.Manual ? "At" : camera.HoldReason is not null ? "Holding on" : "Visiting";
            return $"{verb} “{name}”";
        }
        if (camera.Manual)
        {
            return "Manual view — auto-follow suspended.";
        }
        return camera.FocusKind switch
        {
            CameraFocusKind.Chain => $"Touring {ChainLabel(projection, snapshot, camera.FocusId)}.",
            _ => "Overview — the whole backlog.",
        };
    }

    /// <summary>Names a chain by its series prefix, else by the title of the member most others wait on.</summary>
    private static string ChainLabel(FleetProjection? projection, FleetSnapshot? snapshot, string chainId, bool bare = false)
    {
        foreach (var chain in projection?.Chains ?? [])
        {
            if (!string.Equals(chain.Id, chainId, StringComparison.Ordinal))
            {
                continue;
            }
            if (chain.SeriesPrefix is { Length: > 0 } prefix)
            {
                return bare ? prefix : $"chain “{prefix}” ({chain.ItemIds.Count} items)";
            }
            var members = chain.ItemIds.ToHashSet(StringComparer.Ordinal);
            var items = (snapshot?.Items ?? []).Where(i => members.Contains(i.Id)).ToList();
            var root = items
                .OrderByDescending(i => items.Count(o => o.DependsOn.Contains(i.Id, StringComparer.Ordinal)))
                .ThenBy(i => i.DependsOn.Count)
                .ThenBy(i => i.Id, StringComparer.Ordinal)
                .FirstOrDefault();
            var name = root is null || string.IsNullOrWhiteSpace(root.Title)
                ? ShortId(chain.Id.Replace("chain-", string.Empty, StringComparison.Ordinal))
                : root.Title.Length > 48 ? root.Title[..47] + "…" : root.Title;
            return bare ? name : $"chain “{name}” ({chain.ItemIds.Count} items)";
        }
        return chainId;
    }
}
