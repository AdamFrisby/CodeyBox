@page "/"
@implements IDisposable
@inject ICodeyBoxApiClient ApiClient

<PageTitle>Queue — CodeyBox Admin</PageTitle>

<h1>Work Queue</h1>

@* ── Queue state banner ──────────────────────────────────────────────────── *@
@if (_queueStatus is not null)
{
    @if (_queueStatus.IsPaused)
    {
        <div class="queue-banner queue-banner-paused">
            <strong>QUEUE PAUSED</strong>
            — reason: @_queueStatus.PausedReason
            @if (_queueStatus.PausedAt is { } at)
            {
                <span> — paused at @at.ToLocalTime().ToString("yyyy-MM-dd HH:mm:ss zzz")</span>
            }
            <button class="btn btn-resume" @onclick="ResumeQueueAsync">Resume queue</button>
        </div>
    }
    else
    {
        <div class="queue-banner queue-banner-running">
            <span class="queue-running-dot">●</span> Queue running
            <button class="btn btn-sm" @onclick="ShowPauseModal">Pause queue</button>
        </div>
    }
}

@* ── Pause modal ─────────────────────────────────────────────────────────── *@
@if (_showPauseModal)
{
    <div class="modal-overlay">
        <div class="modal-box">
            <h2>Pause queue</h2>
            <p>New work-item pickup will stop immediately. In-flight items will finish normally.</p>
            <label>
                Reason
                <input type="text" @bind="_pauseReason" placeholder="e.g. maintenance window" class="modal-input" maxlength="500" />
            </label>
            @if (_pauseError is not null)
            {
                <p class="error-banner">@_pauseError</p>
            }
            <div class="modal-actions">
                <button class="btn btn-danger" @onclick="PauseQueueAsync">Pause</button>
                <button class="btn" @onclick="HidePauseModal">Cancel</button>
            </div>
        </div>
    </div>
}

@* ── Budget usage bars ───────────────────────────────────────────────────── *@
@if (_budgetUsage.Count > 0 || _costBudgets.Count > 0)
{
    <div style="margin-bottom:1rem;">
        <strong style="font-size:0.85rem;display:block;margin-bottom:0.4rem;">Project budget</strong>
        @foreach (var pid in _budgetUsage.Keys.Union(_costBudgets.Keys).Distinct())
        {
            _budgetUsage.TryGetValue(pid, out var u);
            _costBudgets.TryGetValue(pid, out var cb);
            var hPct = u is not null ? BudgetPct(u.LastHour, u.Limits.PerHour) : 0;
            var dPct = u is not null ? BudgetPct(u.Last24h, u.Limits.PerDay) : 0;
            var cPct = u is not null ? BudgetPct(u.CurrentlyInFlight, u.Limits.Concurrent) : 0;
            var costPct = cb is not null && cb.MonthlyBudgetUsd > 0 ? (int)Math.Min(100, cb.Pct) : 0;
            var costCss = cb?.ThresholdState switch { "exceeded" => "budget-full", "warning" => "budget-warn", _ => "" };
            <div style="display:flex;align-items:center;gap:1rem;padding:0.2rem 0;font-size:0.82rem;flex-wrap:wrap;">
                <span style="min-width:8rem;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;" title="@pid">@pid</span>
                @if (u is not null)
                {
                    <span>
                        <span class="budget-bar-wrap"><span class="budget-bar @BudgetCss(hPct)" style="width:@(Math.Min(100, hPct))%"></span></span>
                        <span style="margin-left:0.3rem;">@u.LastHour/@(u.Limits.PerHour == 0 ? "∞" : u.Limits.PerHour.ToString())/h</span>
                    </span>
                    <span>
                        <span class="budget-bar-wrap"><span class="budget-bar @BudgetCss(dPct)" style="width:@(Math.Min(100, dPct))%"></span></span>
                        <span style="margin-left:0.3rem;">@u.Last24h/@(u.Limits.PerDay == 0 ? "∞" : u.Limits.PerDay.ToString())/24h</span>
                    </span>
                    <span>
                        <span class="budget-bar-wrap"><span class="budget-bar @BudgetCss(cPct)" style="width:@(Math.Min(100, cPct))%"></span></span>
                        <span style="margin-left:0.3rem;">@u.CurrentlyInFlight/@(u.Limits.Concurrent == 0 ? "∞" : u.Limits.Concurrent.ToString()) fly</span>
                    </span>
                }
                @if (cb is not null && cb.MonthlyBudgetUsd > 0)
                {
                    <span title="30-day cost budget: $@cb.CurrentSpendUsd.ToString("F2") of $@cb.MonthlyBudgetUsd.ToString("F2") (@cb.Pct.ToString("F1")%)">
                        <span class="budget-bar-wrap"><span class="budget-bar @costCss" style="width:@costPct%"></span></span>
                        <span style="margin-left:0.3rem;">$@cb.CurrentSpendUsd.ToString("F2")/$@cb.MonthlyBudgetUsd.ToString("F2")/30d</span>
                    </span>
                }
                @if (cb?.ProjectQueue?.Paused == true)
                {
                    <span style="color:#c00;font-weight:bold;">⏸ PROJECT PAUSED</span>
                    <button class="btn btn-sm" @onclick="() => ResumeProjectAsync(pid)">Resume</button>
                }
                else
                {
                    <button class="btn btn-sm" @onclick="() => PauseProjectAsync(pid)">Pause project</button>
                }
            </div>
        }
    </div>
}

@if (_resumeError is not null)
{
    <p class="error-banner">Resume failed: @_resumeError</p>
}

@if (_error is not null)
{
    <p class="error-banner">Error loading queue: @_error</p>
}

@* ── Tabs: Active | Done | Pending | All ─────────────────────────────────── *@
@if (_items is not null)
{
    <div class="timeline-filters" role="tablist" aria-label="Queue filters">
        @foreach (var tab in _tabs)
        {
            var count = CountForTab(tab);
            <button type="button"
                    role="tab"
                    aria-selected="@(_activeTab == tab)"
                    class="filter-chip @(_activeTab == tab ? "filter-chip--active" : "")"
                    @onclick="@(() => SelectTab(tab))">
                @tab <span class="timeline-group-count">(@count)</span>
            </button>
        }
    </div>
}

@{
    var visibleItems = _items is null ? null : ItemsForTab(_activeTab);
}

@if (_items is null)
{
    <p>Loading…</p>
}
else if (_items.Count == 0)
{
    <p>No work items.</p>
}
else if (visibleItems!.Count == 0)
{
    <p>No @(_activeTab.ToLowerInvariant()) work items.</p>
}
else
{
    <table class="queue-table">
        <thead>
            <tr>
                <th>ID</th>
                <th>Project</th>
                <th>Title</th>
                <th>Agent</th>
                <th>State</th>
                <th>Age</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in visibleItems!)
            {
                var projPaused = _costBudgets.TryGetValue(item.ProjectId, out var cb) && cb?.ProjectQueue?.Paused == true;
                <tr class="state-@item.State.ToLowerInvariant()">
                    <td class="col-id">
                        <a href="/work-items/@item.Id">@item.ShortId</a>
                        @if (item.ExternalId is not null)
                        {
                            var display = item.ExternalId.Length > 16 ? item.ExternalId[..16] + "…" : item.ExternalId;
                            <span class="external-id" title="@item.ExternalId">@display</span>
                        }
                    </td>
                    <td>
                        @item.ProjectId
                        @if (projPaused && item.IsQueued)
                        {
                            <span class="project-paused-badge" title="@cb!.ProjectQueue.PausedReason">⏸ PROJECT PAUSED — budget exceeded — $@cb!.CurrentSpendUsd.ToString("F2") over $@cb!.MonthlyBudgetUsd.ToString("F2")</span>
                        }
                    </td>
                    <td>@item.Title</td>
                    <td>
                        @if (_activeTab == "Active" && !string.IsNullOrWhiteSpace(item.Agent))
                        {
                            <strong title="Agent currently working this item">@item.Agent</strong>
                        }
                        else
                        {
                            @(string.IsNullOrWhiteSpace(item.Agent) ? "—" : item.Agent)
                        }
                    </td>
                    <td class="col-state">@item.State</td>
                    <td class="col-age">@item.Age</td>
                    <td class="col-actions">
                        <a href="/work-items/@item.Id" class="btn">open</a>
                        @if (item.IsQueued)
                        {
                            <a href="/work-items/@item.Id/edit" class="btn">edit</a>
                            <form method="post" action="/admin/move/@item.Id/up" style="display:inline">
                                <AntiforgeryToken />
                                <button type="submit" class="btn btn-up" title="Move up">▲</button>
                            </form>
                            <form method="post" action="/admin/move/@item.Id/down" style="display:inline">
                                <AntiforgeryToken />
                                <button type="submit" class="btn btn-down" title="Move down">▼</button>
                            </form>
                        }
                        @if (!item.IsTerminal)
                        {
                            <button class="btn btn-danger" @onclick="() => CancelAsync(item.Id)">cancel</button>
                        }
                        @if (item.State is "Failed" or "AuditFailed" or "Cancelled")
                        {
                            <button class="btn" @onclick="() => RetryAsync(item.Id)">retry</button>
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>
}

@code {
    private List<WorkItemDto>? _items;
    private QueueStatusDto? _queueStatus;
    private Dictionary<string, BudgetUsageDto> _budgetUsage = [];
    private Dictionary<string, ProjectBudgetDto> _costBudgets = [];
    private string? _error;
    private string? _resumeError;
    private CancellationTokenSource? _cts;
    private Task? _refreshLoop;

    private bool _showPauseModal;
    private string _pauseReason = "";
    private string? _pauseError;

    // ── Tabs ─────────────────────────────────────────────────────────────────
    private static readonly string[] _tabs = ["Active", "Done", "Pending", "All"];
    private string _activeTab = "Active";

    // "Active" = an agent is actively doing something with the item right now.
    private static readonly HashSet<string> _activeStates = new(StringComparer.Ordinal)
    {
        "Working", "Reworking", "ReworkingForConflict",
        "Auditing", "AuditPassed", "Merging", "UpstreamPushing",
    };

    // "Pending" = waiting for something (queue slot, operator, quota).
    private static readonly HashSet<string> _pendingStates = new(StringComparer.Ordinal)
    {
        "Queued", "WorkComplete", "NeedsOperatorInput", "WaitingForQuotaReset",
    };

    private List<WorkItemDto> ItemsForTab(string tab) => tab switch
    {
        // Active and Done are sorted by last-updated descending.
        "Active" => (_items ?? [])
            .Where(i => _activeStates.Contains(i.State))
            .OrderByDescending(i => i.UpdatedAt).ToList(),
        "Done" => (_items ?? [])
            .Where(i => i.State == "Done")
            .OrderByDescending(i => i.UpdatedAt).ToList(),
        // Pending sorted by true priority (highest first), NOT separated by state,
        // so the real priority of any waiting task is visible across Queued/WorkComplete/etc.
        "Pending" => (_items ?? [])
            .Where(i => _pendingStates.Contains(i.State))
            .OrderByDescending(i => i.Priority).ToList(),
        // "All" preserves the default ordering (queued-by-position, then others).
        _ => _items ?? [],
    };

    private int CountForTab(string tab) => ItemsForTab(tab).Count;

    // Switching tabs is pure client-side state; the @{ visibleItems } block and the
    // table re-derive from _activeTab on the next render, so just set the field.
    private void SelectTab(string tab) => _activeTab = tab;

    protected override async Task OnInitializedAsync()
    {
        _cts = new CancellationTokenSource();
        await LoadAsync();
    }

    protected override void OnAfterRender(bool firstRender)
    {
        // Start the auto-refresh loop only once the interactive circuit is live.
        // Starting it from OnInitializedAsync runs it during prerender too and can
        // overlap with the live circuit; gating on firstRender keeps a single loop
        // tied to the interactive component instance.
        if (firstRender && _refreshLoop is null && _cts is not null)
        {
            _refreshLoop = RefreshLoopAsync(_cts.Token);
        }
    }

    private async Task RefreshLoopAsync(CancellationToken ct)
    {
        using var timer = new PeriodicTimer(TimeSpan.FromSeconds(5));
        try
        {
            while (await timer.WaitForNextTickAsync(ct))
            {
                // Awaited inline so a slow LoadAsync (many sequential per-project
                // budget calls) can never overlap itself and flood the single
                // circuit dispatcher — overlapping refreshes were starving click
                // events from reaching the UI.
                await LoadAsync();
                await InvokeAsync(StateHasChanged);
            }
        }
        catch (OperationCanceledException) { }
    }

    private async Task LoadAsync()
    {
        try
        {
            var all = await ApiClient.GetWorkItemsAsync();
            var queued = all.Where(i => i.IsQueued).OrderBy(i => i.QueuePosition).ToList();
            var others = all.Where(i => !i.IsQueued).OrderByDescending(i => i.UpdatedAt).ToList();
            _items = [.. queued, .. others];
            _error = null;
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }

        try { _queueStatus = await ApiClient.GetQueueStatusAsync(); }
        catch (HttpRequestException) { /* non-critical; banner just won't show */ }
        catch (TaskCanceledException) { /* non-critical */ }

        // Load budget usage for projects with non-terminal items.
        var projectIds = _items?
            .Where(i => !i.IsTerminal)
            .Select(i => i.ProjectId)
            .Distinct()
            .ToList() ?? [];
        var usage = new Dictionary<string, BudgetUsageDto>();
        var costBudgets = new Dictionary<string, ProjectBudgetDto>();
        foreach (var pid in projectIds)
        {
            try
            {
                var u = await ApiClient.GetBudgetUsageAsync(pid);
                if (u is not null) usage[pid] = u;
            }
            catch (HttpRequestException) { /* non-critical */ }
            catch (TaskCanceledException) { /* non-critical */ }

            try
            {
                var cb = await ApiClient.GetProjectBudgetAsync(pid);
                if (cb is not null) costBudgets[pid] = cb;
            }
            catch (HttpRequestException) { /* non-critical */ }
            catch (TaskCanceledException) { /* non-critical */ }
        }
        _budgetUsage = usage;
        _costBudgets = costBudgets;
    }

    private async Task PauseProjectAsync(string projectId)
    {
        try
        {
            await ApiClient.PauseProjectQueueAsync(projectId, "manual pause via admin dashboard");
            await LoadAsync();
        }
        catch (Exception ex) { _resumeError = ex.Message; }
    }

    private async Task ResumeProjectAsync(string projectId)
    {
        try
        {
            await ApiClient.ResumeProjectQueueAsync(projectId);
            await LoadAsync();
        }
        catch (Exception ex) { _resumeError = ex.Message; }
    }

    private async Task CancelAsync(string id)
    {
        await ApiClient.DeleteWorkItemAsync(id);
        await LoadAsync();
    }

    private async Task RetryAsync(string id)
    {
        await ApiClient.RetryWorkItemAsync(id);
        await LoadAsync();
    }

    private void ShowPauseModal()
    {
        _pauseReason = "";
        _pauseError = null;
        _showPauseModal = true;
    }

    private void HidePauseModal() => _showPauseModal = false;

    private async Task PauseQueueAsync()
    {
        if (string.IsNullOrWhiteSpace(_pauseReason))
        {
            _pauseError = "A reason is required.";
            return;
        }
        try
        {
            var result = await ApiClient.PauseQueueAsync(_pauseReason.Trim());
            if (result is null)
            {
                _pauseError = "Pause request failed: server returned an empty response.";
                return;
            }
            _queueStatus = result;
            _showPauseModal = false;
            _pauseError = null;
            await LoadAsync();
        }
        catch (Exception ex)
        {
            _pauseError = ex.Message;
        }
    }

    private async Task ResumeQueueAsync()
    {
        _resumeError = null;
        try
        {
            _queueStatus = await ApiClient.ResumeQueueAsync();
            await LoadAsync();
        }
        catch (Exception ex) { _resumeError = ex.Message; }
    }

    public void Dispose()
    {
        _cts?.Cancel();
        _cts?.Dispose();
    }

    private static int BudgetPct(int used, int limit) =>
        limit <= 0 ? 0 : Math.Min(100, (int)(100.0 * used / limit));

    private static string BudgetCss(int pct) =>
        pct >= 100 ? "budget-full" : pct >= 80 ? "budget-warn" : "";
}
