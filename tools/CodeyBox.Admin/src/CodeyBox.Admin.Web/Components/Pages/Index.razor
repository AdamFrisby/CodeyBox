@page "/"
@implements IDisposable
@inject ICodeyBoxApiClient ApiClient

<PageTitle>Queue — CodeyBox Admin</PageTitle>

<h1>Work Queue</h1>

@* ── Queue state banner ──────────────────────────────────────────────────── *@
@if (_queueStatus is not null)
{
    @if (_queueStatus.IsPaused)
    {
        <div class="queue-banner queue-banner-paused">
            <strong>QUEUE PAUSED</strong>
            — reason: @_queueStatus.PausedReason
            @if (_queueStatus.PausedAt is { } at)
            {
                <span> — paused at @at.ToLocalTime().ToString("yyyy-MM-dd HH:mm:ss zzz")</span>
            }
            <button class="btn btn-resume" @onclick="ResumeQueueAsync">Resume queue</button>
        </div>
    }
    else
    {
        <div class="queue-banner queue-banner-running">
            <span class="queue-running-dot">●</span> Queue running
            <button class="btn btn-sm" @onclick="ShowPauseModal">Pause queue</button>
        </div>
    }
}

@* ── Pause modal ─────────────────────────────────────────────────────────── *@
@if (_showPauseModal)
{
    <div class="modal-overlay">
        <div class="modal-box">
            <h2>Pause queue</h2>
            <p>New work-item pickup will stop immediately. In-flight items will finish normally.</p>
            <label>
                Reason
                <input type="text" @bind="_pauseReason" placeholder="e.g. maintenance window" class="modal-input" />
            </label>
            @if (_pauseError is not null)
            {
                <p class="error-banner">@_pauseError</p>
            }
            <div class="modal-actions">
                <button class="btn btn-danger" @onclick="PauseQueueAsync">Pause</button>
                <button class="btn" @onclick="HidePauseModal">Cancel</button>
            </div>
        </div>
    </div>
}

@if (_error is not null)
{
    <p class="error-banner">Error loading queue: @_error</p>
}

@if (_items is null)
{
    <p>Loading…</p>
}
else if (_items.Count == 0)
{
    <p>No work items.</p>
}
else
{
    <table class="queue-table">
        <thead>
            <tr>
                <th>ID</th>
                <th>Project</th>
                <th>Title</th>
                <th>Agent</th>
                <th>State</th>
                <th>Age</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in _items)
            {
                <tr class="state-@item.State.ToLowerInvariant()">
                    <td class="col-id">
                        <a href="/work-items/@item.Id">@item.ShortId</a>
                    </td>
                    <td>@item.ProjectId</td>
                    <td>@item.Title</td>
                    <td>@item.Agent</td>
                    <td class="col-state">@item.State</td>
                    <td class="col-age">@item.Age</td>
                    <td class="col-actions">
                        <a href="/work-items/@item.Id" class="btn">open</a>
                        @if (item.IsQueued)
                        {
                            <a href="/work-items/@item.Id/edit" class="btn">edit</a>
                            <form method="post" action="/admin/move/@item.Id/up" style="display:inline">
                                <AntiforgeryToken />
                                <button type="submit" class="btn btn-up" title="Move up">▲</button>
                            </form>
                            <form method="post" action="/admin/move/@item.Id/down" style="display:inline">
                                <AntiforgeryToken />
                                <button type="submit" class="btn btn-down" title="Move down">▼</button>
                            </form>
                        }
                        @if (!item.IsTerminal)
                        {
                            <button class="btn btn-danger" @onclick="() => CancelAsync(item.Id)">cancel</button>
                        }
                        @if (item.State is "Failed" or "AuditFailed" or "Cancelled")
                        {
                            <button class="btn" @onclick="() => RetryAsync(item.Id)">retry</button>
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>
}

@code {
    private List<WorkItemDto>? _items;
    private QueueStatusDto? _queueStatus;
    private string? _error;
    private CancellationTokenSource? _cts;

    private bool _showPauseModal;
    private string _pauseReason = "";
    private string? _pauseError;

    protected override async Task OnInitializedAsync()
    {
        _cts = new CancellationTokenSource();
        await LoadAsync();
        _ = RefreshLoopAsync(_cts.Token);
    }

    private async Task RefreshLoopAsync(CancellationToken ct)
    {
        using var timer = new PeriodicTimer(TimeSpan.FromSeconds(5));
        try
        {
            while (await timer.WaitForNextTickAsync(ct))
            {
                await LoadAsync();
                await InvokeAsync(StateHasChanged);
            }
        }
        catch (OperationCanceledException) { }
    }

    private async Task LoadAsync()
    {
        try
        {
            var all = await ApiClient.GetWorkItemsAsync();
            var queued = all.Where(i => i.IsQueued).OrderBy(i => i.QueuePosition).ToList();
            var others = all.Where(i => !i.IsQueued).OrderByDescending(i => i.UpdatedAt).ToList();
            _items = [.. queued, .. others];
            _error = null;
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }

        try { _queueStatus = await ApiClient.GetQueueStatusAsync(); }
        catch { /* non-critical; banner just won't show */ }
    }

    private async Task CancelAsync(string id)
    {
        await ApiClient.DeleteWorkItemAsync(id);
        await LoadAsync();
    }

    private async Task RetryAsync(string id)
    {
        await ApiClient.RetryWorkItemAsync(id);
        await LoadAsync();
    }

    private void ShowPauseModal()
    {
        _pauseReason = "";
        _pauseError = null;
        _showPauseModal = true;
    }

    private void HidePauseModal() => _showPauseModal = false;

    private async Task PauseQueueAsync()
    {
        if (string.IsNullOrWhiteSpace(_pauseReason))
        {
            _pauseError = "A reason is required.";
            return;
        }
        try
        {
            _queueStatus = await ApiClient.PauseQueueAsync(_pauseReason.Trim());
            _showPauseModal = false;
            _pauseError = null;
        }
        catch (Exception ex)
        {
            _pauseError = ex.Message;
        }
    }

    private async Task ResumeQueueAsync()
    {
        try { _queueStatus = await ApiClient.ResumeQueueAsync(); }
        catch { /* ignore; next poll will refresh */ }
    }

    public void Dispose()
    {
        _cts?.Cancel();
        _cts?.Dispose();
    }
}
