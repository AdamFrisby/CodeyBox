@page "/fleet"
@implements IDisposable
@inject ICodeyBoxApiClient ApiClient
@inject ILogger<Fleet> Logger

<PageTitle>Fleet — CodeyBox Admin</PageTitle>

<h1>Fleet</h1>

@* ── Per-project pause fallback banner ───────────────────────────────────── *@
<div class="queue-banner" style="background:#f5f0e0;border:1px solid #d4b800;padding:0.5rem 0.75rem;margin-bottom:1rem;font-size:0.85rem;">
    Per-project pause requires the budget-alerts work item; falling back to global queue pause.
    Use the <a href="/">Queue</a> page for pause/resume. Pause buttons below affect the <strong>entire queue</strong>.
</div>

@if (_error is not null)
{
    <p class="error-banner">Error loading fleet: @_error</p>
}

<section class="agent-controls" style="margin-bottom:1rem;">
    <h2>Agent controls</h2>
    <div style="display:flex;gap:0.5rem;flex-wrap:wrap;align-items:end;">
        <label>
            <span>Agent</span><br />
            <input style="min-width:8rem;" @bind="_agentPauseKind" />
        </label>
        <label>
            <span>Reason</span><br />
            <input style="min-width:16rem;" @bind="_agentPauseReason" />
        </label>
        <label>
            <span>Hours</span><br />
            <input style="width:5rem;" type="number" min="0" step="0.25" @bind="_agentPauseHours" />
        </label>
        <button class="btn btn-agent-pause" @onclick="PauseAgentAsync">Pause</button>
    </div>
    @if (_pausedAgents is { Count: > 0 })
    {
        <table class="queue-table" style="margin-top:0.75rem;">
            <thead>
                <tr>
                    <th>Agent</th>
                    <th>Reason</th>
                    <th>Paused</th>
                    <th>Expires</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var p in _pausedAgents)
                {
                    <tr>
                        <td><code>@p.Agent</code></td>
                        <td>@(p.PausedReason ?? "—")</td>
                        <td>@FormatDate(p.PausedAt)</td>
                        <td>@FormatDate(p.ExpiresAt)</td>
                        <td>
                            <button class="btn btn-agent-resume" @onclick="() => ResumeAgentAsync(p.Agent)">Resume</button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }
    else
    {
        <p style="color:#666;margin-top:0.5rem;">No paused agents.</p>
    }
</section>

@if (_summaries is null)
{
    <p>Loading…</p>
}
else if (_summaries.Count == 0)
{
    <p>No projects configured.</p>
}
else
{
    <table class="queue-table">
        <thead>
            <tr>
                <th>Project</th>
                <th title="Grey=idle, Blue=in-flight, Yellow=queued, Red=paused or ≥3 recent failures">Status</th>
                <th>Current phase</th>
                <th>Queued</th>
                <th>In-flight</th>
                <th>Last 5</th>
                <th>Budget (30 d)</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var s in _summaries)
            {
                <tr>
                    <td>
                        <strong>@s.DisplayName</strong>
                        <br />
                        <span class="external-id" title="@s.ProjectId">@ShortId(s.ProjectId)</span>
                    </td>
                    <td>
                        <span class="fleet-dot fleet-dot-@s.StatusColor" title="@StatusTitle(s)">●</span>
                    </td>
                    <td>@(s.CurrentPhase ?? "—")</td>
                    <td>@s.QueuedCount</td>
                    <td>@s.InFlightCount</td>
                    <td class="fleet-outcomes">
                        @foreach (var o in s.RecentOutcomes)
                        {
                            <span class="fleet-outcome fleet-outcome-@OutcomeCss(o)" title="@o">@OutcomeGlyph(o)</span>
                        }
                        @if (s.RecentOutcomes.Count == 0)
                        {
                            <span style="color:#999">—</span>
                        }
                    </td>
                    <td>
                        @if (s.MonthlySpendUsd.HasValue)
                        {
                            <div style="display:flex;align-items:center;gap:0.4rem;">
                                <span class="budget-bar-wrap" style="width:5rem;">
                                    <span class="budget-bar @s.BudgetBarCss" style="width:@((int)s.BudgetPct)%"></span>
                                </span>
                                <span>$@s.MonthlySpendUsd.Value.ToString("0.00")@(s.MonthlyBudgetUsd.HasValue ? $" / ${s.MonthlyBudgetUsd.Value:0}" : "")</span>
                            </div>
                        }
                        else
                        {
                            <span style="color:#999">—</span>
                        }
                    </td>
                    <td>
                        @if (s.IsPaused)
                        {
                            <button class="btn btn-fleet-resume" title="Resumes the global queue (per-project pause not yet available)" @onclick="() => ResumeProjectAsync(s.ProjectId)">Resume queue (global)</button>
                        }
                        else
                        {
                            <button class="btn btn-fleet-pause" title="Pauses the global queue — affects ALL projects (per-project pause not yet available)" @onclick="() => PauseProjectAsync(s.ProjectId)">Pause queue (global)</button>
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>

    @if (_agentActivity?.SlowestToolCalls.Count > 0)
    {
        <section class="fleet-tool-leaderboard">
            <h2>Slowest tool calls</h2>
            <table class="detail-table fleet-tool-leaderboard-table">
                <thead>
                    <tr>
                        <th>Work item</th>
                        <th>Invocation</th>
                        <th>Tool</th>
                        <th>Duration</th>
                        <th>Status</th>
                        <th>Input</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var tool in _agentActivity.SlowestToolCalls)
                    {
                        <tr>
                            <td><a href="/work-items/@tool.WorkItemId/timings">@ShortId(tool.WorkItemId)</a></td>
                            <td>
                                <code>@(tool.Phase ?? "unknown")</code>
                                @if (tool.Iteration.HasValue)
                                {
                                    <span>iter @tool.Iteration</span>
                                }
                            </td>
                            <td><code>@tool.ToolName</code></td>
                            <td>@(tool.DurationMs.HasValue ? FormatDuration(tool.DurationMs.Value) : "unfinished")</td>
                            <td>@FormatToolStatus(tool.Succeeded)</td>
                            <td><code>@tool.InputSummary</code></td>
                        </tr>
                    }
                </tbody>
            </table>
        </section>
    }
}

@code {
    private List<FleetSummaryDto>? _summaries;
    private List<AgentPauseStateDto> _pausedAgents = [];
    private AgentStreamAggregateDto? _agentActivity;
    private string? _error;
    private string _agentPauseKind = "";
    private string _agentPauseReason = "";
    private double? _agentPauseHours;
    private CancellationTokenSource? _cts;

    protected override async Task OnInitializedAsync()
    {
        _cts = new CancellationTokenSource();
        await LoadAsync();
        _ = RefreshLoopAsync(_cts.Token);
    }

    private async Task RefreshLoopAsync(CancellationToken ct)
    {
        using var timer = new PeriodicTimer(TimeSpan.FromSeconds(5));
        try
        {
            while (await timer.WaitForNextTickAsync(ct))
            {
                await LoadAsync();
                await InvokeAsync(StateHasChanged);
            }
        }
        catch (OperationCanceledException) { }
    }

    private async Task LoadAsync()
    {
        try
        {
            var ct = _cts?.Token ?? default;
            _summaries = await ApiClient.GetFleetSummaryAsync(ct);
            _pausedAgents = await ApiClient.GetPausedAgentsAsync(ct);
            _agentActivity = await ApiClient.GetFleetAgentStreamAggregateAsync(50, ct);
            _error = null;
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Fleet: failed to load fleet summary");
            _error = "Failed to load fleet data. Check server logs for details.";
        }
    }

    private async Task PauseAgentAsync()
    {
        if (string.IsNullOrWhiteSpace(_agentPauseKind) || string.IsNullOrWhiteSpace(_agentPauseReason))
        {
            _error = "Agent and reason are required.";
            return;
        }

        try
        {
            var seconds = _agentPauseHours is > 0
                ? _agentPauseHours.Value * 3600
                : (double?)null;
            await ApiClient.PauseAgentAsync(_agentPauseKind.Trim(), _agentPauseReason.Trim(), seconds);
            _agentPauseKind = "";
            _agentPauseReason = "";
            _agentPauseHours = null;
            await LoadAsync();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Fleet: failed to pause agent {Agent}", _agentPauseKind);
            _error = "Failed to pause agent. Check server logs for details.";
        }
    }

    private async Task ResumeAgentAsync(string agent)
    {
        try
        {
            await ApiClient.ResumeAgentAsync(agent);
            await LoadAsync();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Fleet: failed to resume agent {Agent}", agent);
            _error = "Failed to resume agent. Check server logs for details.";
        }
    }

    private async Task PauseProjectAsync(string projectId)
    {
        try
        {
            await ApiClient.PauseProjectAsync(projectId, "Operator pause from Fleet view");
            await LoadAsync();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Fleet: failed to pause queue for project {ProjectId}", projectId);
            _error = "Failed to pause queue. Check server logs for details.";
        }
    }

    private async Task ResumeProjectAsync(string projectId)
    {
        try
        {
            await ApiClient.ResumeProjectAsync(projectId);
            await LoadAsync();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Fleet: failed to resume queue for project {ProjectId}", projectId);
            _error = "Failed to resume queue. Check server logs for details.";
        }
    }

    public void Dispose()
    {
        _cts?.Cancel();
        _cts?.Dispose();
    }

    private static string ShortId(string id) =>
        id.Length > 12 ? id[..12] + "…" : id;

    private static string StatusTitle(FleetSummaryDto s) =>
        s.IsPaused ? "Paused" :
        s.HasRecentFailures ? "Recent failures (≥3 of last 5 outcomes)" :
        s.InFlightCount > 0 ? "In-flight" :
        s.QueuedCount > 0 ? "Queued (waiting)" :
        "Idle";

    private static string OutcomeCss(string state) =>
        state is "Done" ? "ok" :
        state is "Failed" or "AuditFailed" ? "fail" :
        "cancel";

    private static string OutcomeGlyph(string state) =>
        state is "Done" ? "✓" :
        state is "Failed" or "AuditFailed" ? "✗" :
        "!";

    private static string FormatToolStatus(bool? succeeded) => succeeded switch
    {
        true => "ok",
        false => "error",
        null => "unknown",
    };

    private static string FormatDuration(long ms)
    {
        if (ms < 1000) return $"{ms}ms";
        if (ms < 60_000) return $"{ms / 1000.0:F1}s";
        var min = ms / 60_000;
        var sec = (ms % 60_000) / 1000;
        return $"{min}m {sec}s";
    }

    private static string FormatDate(DateTimeOffset? value) =>
        value is null ? "—" : value.Value.ToLocalTime().ToString("yyyy-MM-dd HH:mm");
}
