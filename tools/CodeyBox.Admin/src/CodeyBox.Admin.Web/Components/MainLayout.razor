@inherits LayoutComponentBase
@inject ICodeyBoxApiClient ApiClient
@inject ILogger<MainLayout> Logger

<div class="admin-layout">
    <nav class="admin-nav">
        <span class="admin-nav-brand">CodeyBox Admin</span>
        <NavLink href="/" Match="NavLinkMatch.All">Queue</NavLink>
        <NavLink href="/work-items/new">+ New Item</NavLink>
        <NavLink href="/fleet">Fleet</NavLink>
        <NavLink href="/supervision">Supervision</NavLink>
        <NavLink href="/suggestions">
            <span>Suggestions</span>
            @if (_openCount > 0)
            {
                <span class="nav-badge">@_openCount</span>
            }
        </NavLink>
        <NavLink href="/plugins">Plugins</NavLink>
        <NavLink href="/statistics">Statistics</NavLink>
        <NavLink href="/capacity">Capacity</NavLink>
        <NavLink href="/releases">
            <span>Releases</span>
            @if (_openReleasesCount > 0)
            {
                <span class="nav-badge">@_openReleasesCount</span>
            }
        </NavLink>
    </nav>
    <main class="admin-main">
        @Body
    </main>
</div>

@code {
    private int _openCount;
    private int _openReleasesCount;

    protected override async Task OnInitializedAsync()
    {
        await Task.WhenAll(FetchSuggestionsCountAsync(), FetchOpenReleasesCountAsync());
    }

    private async Task FetchSuggestionsCountAsync()
    {
        try { _openCount = await ApiClient.GetSuggestionsCountAsync(); }
        catch (Exception ex) { Logger.LogWarning(ex, "Failed to fetch open suggestion count for nav badge"); }
    }

    private async Task FetchOpenReleasesCountAsync()
    {
        try { _openReleasesCount = await ApiClient.GetOpenReleasesCountAsync(); }
        catch (Exception ex) { Logger.LogWarning(ex, "Failed to fetch open releases count for nav badge"); }
    }
}
