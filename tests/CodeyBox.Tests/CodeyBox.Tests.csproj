<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <!-- Suppress vulnerability advisories for OTel transitive dependencies that have no patched
       version in the local NuGet cache. Mirrored from CodeyBox.Api.csproj. -->
  <ItemGroup>
    <NuGetAuditSuppress Include="https://github.com/advisories/GHSA-g94r-2vxg-569j" />
    <NuGetAuditSuppress Include="https://github.com/advisories/GHSA-4625-4j76-fww9" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.4" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="Serilog" Version="4.2.0" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
    <PackageReference Include="Xunit.SkippableFact" Version="1.4.13" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="Fixtures\**\*.json" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Fixtures\**\*.txt" CopyToOutputDirectory="PreserveNewest" />
    <Compile Remove="Fixtures\**\*.cs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.7" />
    <PackageReference Include="Microsoft.Extensions.Http" Version="10.0.7" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\CodeyBox.Api\CodeyBox.Api.csproj" />
    <ProjectReference Include="..\..\src\CodeyBox.Core\CodeyBox.Core.csproj" />
    <ProjectReference Include="..\..\src\CodeyBox.PluginSdk\CodeyBox.PluginSdk.csproj" />
    <ProjectReference Include="..\..\src\CodeyBox.Orchestrator\CodeyBox.Orchestrator.csproj" />
    <!--
      Build dependency only: ensures CodeyBox.PluginSdk.SampleTests is compiled
      before plugin loader integration tests run. ReferenceOutputAssembly=false
      prevents the sample types from being loaded into the test's default ALC,
      which would interfere with the AssemblyLoadContext isolation under test.
    -->
    <ProjectReference Include="..\CodeyBox.PluginSdk.SampleTests\CodeyBox.PluginSdk.SampleTests.csproj" ReferenceOutputAssembly="false" />
    <ProjectReference Include="..\..\src\CodeyBox.Agents.Claude\CodeyBox.Agents.Claude.csproj" />
    <ProjectReference Include="..\..\src\CodeyBox.Agents.Codex\CodeyBox.Agents.Codex.csproj" />
    <ProjectReference Include="..\..\src\CodeyBox.Agents.Gemini\CodeyBox.Agents.Gemini.csproj" />
    <ProjectReference Include="..\..\src\CodeyBox.Agents.Cursor\CodeyBox.Agents.Cursor.csproj" />
    <ProjectReference Include="..\..\src\CodeyBox.Agents.Opencode\CodeyBox.Agents.Opencode.csproj" />
    <ProjectReference Include="..\..\src\CodeyBox.Git\CodeyBox.Git.csproj" />
    <ProjectReference Include="..\..\src\CodeyBox.Agents\CodeyBox.Agents.csproj" />
    <ProjectReference Include="..\..\src\CodeyBox.Sandbox\CodeyBox.Sandbox.csproj" />
    <ProjectReference Include="..\..\src\CodeyBox.Sandbox.Process\CodeyBox.Sandbox.Process.csproj" />
    <ProjectReference Include="..\..\src\CodeyBox.Upstream\CodeyBox.Upstream.csproj" />
    <ProjectReference Include="..\..\src\CodeyBox.Upstream.GitHub\CodeyBox.Upstream.GitHub.csproj" />
    <ProjectReference Include="..\..\src\CodeyBox.Audit\CodeyBox.Audit.csproj" />
    <ProjectReference Include="..\..\src\CodeyBox.Audit.Shell\CodeyBox.Audit.Shell.csproj" />
    <ProjectReference Include="..\..\src\CodeyBox.Audit.Llm\CodeyBox.Audit.Llm.csproj" />
    <ProjectReference Include="..\..\src\CodeyBox.Sandbox.Bubblewrap\CodeyBox.Sandbox.Bubblewrap.csproj" />
    <ProjectReference Include="..\..\src\CodeyBox.Sandbox.Graphical\CodeyBox.Sandbox.Graphical.csproj" />
    <ProjectReference Include="..\..\src\CodeyBox.Sandbox.Multipass\CodeyBox.Sandbox.Multipass.csproj" />
    <ProjectReference Include="..\..\src\CodeyBox.ExploratoryTesting\CodeyBox.ExploratoryTesting.csproj" />
    <ProjectReference Include="..\..\tools\CodeyBox.Harness\CodeyBox.Harness.csproj" />
    <ProjectReference Include="..\..\src\CodeyBox.Webhooks\CodeyBox.Webhooks.csproj" />
    <ProjectReference Include="..\..\tools\CodeyBox.Admin\src\CodeyBox.Admin.Web\CodeyBox.Admin.Web.csproj" Aliases="CodeyBoxAdminWeb" />
    <!--
      Build dependency only: the CLI UAT tests spawn the CLI as an out-of-process
      child to exercise the real entry point. ReferenceOutputAssembly=false keeps
      the CLI's types out of the test ALC; the build dependency just guarantees
      the CLI dll is on disk so the tests can invoke it via `dotnet path/to/dll`
      without paying for a per-invocation `dotnet run` rebuild that can exceed
      the test timeout under cold sandbox caches.
    -->
    <ProjectReference Include="..\..\tools\CodeyBox.Cli\CodeyBox.Cli.csproj" ReferenceOutputAssembly="false" />
  </ItemGroup>

</Project>
